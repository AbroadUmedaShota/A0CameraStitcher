* text=auto
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
# Fingerprint vectors compare UTF-8 bytes, including the final LF.
tests/fixtures/rig-profile-v2/*.canonical.txt text eol=lf
tests/fixtures/rig-profile-v2/*.sha256 text eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.vcxproj text eol=crlf

# Embedded UI fonts: keep byte-identical, never line-ending normalized
*.otf binary
*.ttf binary

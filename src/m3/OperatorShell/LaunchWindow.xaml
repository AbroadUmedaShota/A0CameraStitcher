<Window x:Class="A0CameraStitcher.M3.OperatorShell.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A0 Camera Stitcher — 起動モード選択"
        Width="820" Height="560" MinWidth="720" MinHeight="500"
        Background="#FFF4F6F8" FontFamily="Yu Gothic UI"
        AutomationProperties.Name="A0 Camera Stitcher explicit startup mode selector">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="A0 Camera Stitcher" FontSize="32" FontWeight="Bold" Foreground="#FF173E5E" />
            <TextBlock Text="運用構成を明示的に選択してください。接続台数から自動判定しません。" Margin="0,7,0,0" FontSize="16" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="#FF2673A5" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="実機・一台構成" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="登録済みCAM-AまたはCAM-Bの一台だけを使用します。撮影、有限Live View、結果復旧、単体原画像の明示保存を行います。" Margin="0,8,0,12" />
                    <TextBlock Text="二台接続はblocker / 合成は対象外 / 設定writeなし" FontWeight="Bold" Foreground="#FF8E1712" Margin="0,0,0,12" />
                    <Button Content="SingleCameraを開始" Click="OnHardwareSingleClick" Padding="18,12" FontSize="17" FontWeight="Bold"
                            AutomationProperties.Name="実機一台構成を明示選択" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="#FFB06A00" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="実機・二台構成" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="HardwareDual契約を使用します。production identity/provider未接続のため現在は撮影不可です。" Margin="0,8,0,12" />
                    <TextBlock Text="HardwarePending / fallbackなし" FontWeight="Bold" Foreground="#FF8E1712" Margin="0,0,0,12" />
                    <Button Content="HardwareDual状態を表示" Click="OnHardwareDualClick" Padding="18,12" FontSize="17"
                            AutomationProperties.Name="実機二台構成を明示選択しHardwarePendingを表示" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" BorderBrush="#FF8E1712" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="SIMULATED" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="一台／二台の操作設計とdurable transactionを、実カメラ・SDK・WPDへ接続せず確認します。" Margin="0,8,0,12" />
                    <TextBlock Text="製品撮影ではありません" FontWeight="Bold" Foreground="#FF8E1712" Margin="0,0,0,12" />
                    <Button Content="シミュレーションを開始" Click="OnSimulatedClick" Padding="18,12" FontSize="17"
                            AutomationProperties.Name="実機未接続シミュレーションを明示選択" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="12" Background="#FFE8F2FF" BorderBrush="#FF2563A6" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Camera Agent（実機一台構成）" FontWeight="Bold" />
                <TextBlock x:Name="AgentPathText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="AgentAvailabilityText" Margin="0,3,0,0" FontWeight="Bold" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

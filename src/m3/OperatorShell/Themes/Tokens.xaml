<!--
  操作画面のデザイントークン。色・フォント・文字サイズ・影をここへ集約し、
  各XAMLからは StaticResource 参照のみで使う（16進値をXAMLへ直接書かない）。

  角丸は使わない。すべての面と枠は CornerRadius 0 で構成する。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============ フォント ============ -->
    <!-- 同梱フォント。末尾のフォールバックは、埋め込み解決に失敗した環境でも
         日本語が豆腐にならないようにするための保険。 -->
    <FontFamily x:Key="SansFontFamily">pack://application:,,,/Assets/Fonts/#Noto Sans JP, Yu Gothic UI, Meiryo</FontFamily>
    <FontFamily x:Key="MonoFontFamily">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- ============ 文字サイズ ============ -->
    <sys:Double x:Key="FontSizeMicro">9.5</sys:Double>
    <sys:Double x:Key="FontSizeTiny">10</sys:Double>
    <sys:Double x:Key="FontSizeSmall">10.5</sys:Double>
    <sys:Double x:Key="FontSizeCompact">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">11.5</sys:Double>
    <sys:Double x:Key="FontSizeBase">12</sys:Double>
    <sys:Double x:Key="FontSizeLabel">12.5</sys:Double>
    <sys:Double x:Key="FontSizeSection">13</sys:Double>
    <sys:Double x:Key="FontSizeReading">15</sys:Double>
    <sys:Double x:Key="FontSizePrimaryAction">15.5</sys:Double>
    <sys:Double x:Key="FontSizeDialogTitle">17</sys:Double>

    <!-- ============ 面（背景） ============ -->
    <SolidColorBrush x:Key="DesktopBrush" Color="#0B0C0D" />
    <SolidColorBrush x:Key="WindowBrush" Color="#17191B" />
    <SolidColorBrush x:Key="LeftColumnBrush" Color="#131517" />
    <SolidColorBrush x:Key="RightColumnBrush" Color="#1A1D1F" />
    <SolidColorBrush x:Key="CardBrush" Color="#16191B" />
    <SolidColorBrush x:Key="StageBrush" Color="#0D0F10" />
    <SolidColorBrush x:Key="BarBrush" Color="#1E2124" />
    <SolidColorBrush x:Key="MenuBarBrush" Color="#1A1D1F" />
    <SolidColorBrush x:Key="ControlBrush" Color="#1E2124" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#262A2D" />
    <SolidColorBrush x:Key="ControlSunkenBrush" Color="#202325" />
    <SolidColorBrush x:Key="FieldBrush" Color="#16191B" />

    <!-- ============ 境界 ============ -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4044" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2E31" />
    <SolidColorBrush x:Key="BorderWeakBrush" Color="#232628" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#4A5054" />

    <!-- ============ アクセント（緑） ============ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2E7D63" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#7CC4A8" />
    <SolidColorBrush x:Key="AccentDotBrush" Color="#43A57F" />
    <SolidColorBrush x:Key="AccentShadowBrush" Color="#235B49" />
    <SolidColorBrush x:Key="AccentBusyBrush" Color="#235B49" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#2E2E7D63" />
    <SolidColorBrush x:Key="AccentTintSoftBrush" Color="#242E7D63" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="#F2F6F4" />
    <SolidColorBrush x:Key="AccentOnStrongBrush" Color="#F4F8F6" />

    <!-- ============ 注意（琥珀） ============ -->
    <SolidColorBrush x:Key="CautionBrush" Color="#E0AE6C" />
    <SolidColorBrush x:Key="CautionBorderBrush" Color="#A5743A" />
    <SolidColorBrush x:Key="CautionTintBrush" Color="#29B4884A" />
    <SolidColorBrush x:Key="CautionBadgeBrush" Color="#2EB4884A" />
    <SolidColorBrush x:Key="CautionDotBrush" Color="#C7913F" />
    <SolidColorBrush x:Key="CautionNoticeBrush" Color="#F08A6533" />

    <!-- ============ 重大（赤） ============ -->
    <SolidColorBrush x:Key="BlockerBrush" Color="#F2A392" />
    <SolidColorBrush x:Key="BlockerBorderBrush" Color="#A5473A" />
    <SolidColorBrush x:Key="BlockerTintBrush" Color="#2EC8503C" />

    <!-- ============ 情報（青） ============ -->
    <SolidColorBrush x:Key="InfoBrush" Color="#8FB3CC" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#4A6C86" />
    <SolidColorBrush x:Key="InfoTintBrush" Color="#295A82A0" />

    <!-- ============ 文字 ============ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E8E9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8CCCE" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA3A8" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E7679" />
    <SolidColorBrush x:Key="TextMenuBrush" Color="#B5BABC" />
    <SolidColorBrush x:Key="TextControlBrush" Color="#B4BBBE" />
    <SolidColorBrush x:Key="TextStageBrush" Color="#A8B0B4" />

    <!-- ステージ上の重ね表示（半透明） -->
    <SolidColorBrush x:Key="OverlayGridLineBrush" Color="#1FE6E8E9" />
    <SolidColorBrush x:Key="OverlayMarkBrush" Color="#80E6E8E9" />
    <SolidColorBrush x:Key="OverlaySafeMarginBrush" Color="#38E6E8E9" />
    <SolidColorBrush x:Key="OverlaySafeMarginTextBrush" Color="#6BE6E8E9" />
    <SolidColorBrush x:Key="OverlapBandFillBrush" Color="#1A2E7D63" />
    <SolidColorBrush x:Key="OverlapBandEdgeBrush" Color="#A67CC4A8" />
    <SolidColorBrush x:Key="OverlapBandTextBrush" Color="#999CD3BB" />
    <SolidColorBrush x:Key="StageScrimBrush" Color="#B80B0C0D" />
    <SolidColorBrush x:Key="StageChipBrush" Color="#B80D0F10" />
    <SolidColorBrush x:Key="ReticleIdleBrush" Color="#B39AA3A8" />
    <SolidColorBrush x:Key="ModalScrimBrush" Color="#E60B0C0D" />

    <!-- ステージのプレースホルダ地。実LVフレーム未取得のときだけ見える斜線地。 -->
    <DrawingBrush x:Key="StageHatchBrush" TileMode="Tile" Viewport="0,0,13,13" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#232628">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,13,13" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2B2E30">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,13,3" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
        <DrawingBrush.RelativeTransform>
            <RotateTransform Angle="135" CenterX="0.5" CenterY="0.5" />
        </DrawingBrush.RelativeTransform>
    </DrawingBrush>

    <!-- ============ 影 ============ -->
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="50" ShadowDepth="20" Direction="270" Color="#000000" Opacity="0.45" />
    <DropShadowEffect x:Key="DropdownShadow" BlurRadius="34" ShadowDepth="14" Direction="270" Color="#000000" Opacity="0.6" />
    <DropShadowEffect x:Key="LoupeShadow" BlurRadius="28" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.55" />
    <DropShadowEffect x:Key="NoticeShadow" BlurRadius="18" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.5" />

    <!-- ============ 明滅（通知と同時に状態バッジを2回光らせる） ============ -->
    <Storyboard x:Key="StateBadgePulse">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0.35" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="2x" />
    </Storyboard>

</ResourceDictionary>

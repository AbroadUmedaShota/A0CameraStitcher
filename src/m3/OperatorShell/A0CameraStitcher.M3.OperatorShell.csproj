<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>A0CameraStitcher.M3.OperatorShell</AssemblyName>
    <RootNamespace>A0CameraStitcher.M3.OperatorShell</RootNamespace>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</RepositoryRoot>
    <M2AdapterBuildDirectory>$(RepositoryRoot)\build\wpf-m2-adapter</M2AdapterBuildDirectory>
    <M2AdapterSourcePath>$(M2AdapterBuildDirectory)\$(Configuration)\A0CameraStitcher.M2Adapter.exe</M2AdapterSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundation\A0CameraStitcher.M3.Foundation.csproj" />
    <Content Include="$(M2AdapterSourcePath)" Link="A0CameraStitcher.M2Adapter.exe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 操作画面のフォントは同梱する。実機PCへNoto Sans JP / JetBrains Monoが導入されていなくても
       同じ字面・字送りで表示させるため、システムフォントへは依存させない。ライセンスはいずれも
       SIL Open Font License 1.1（同フォルダの *-OFL.txt）。 -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\NotoSansJP-Regular.otf" />
    <Resource Include="Assets\Fonts\NotoSansJP-Medium.otf" />
    <Resource Include="Assets\Fonts\NotoSansJP-Bold.otf" />
    <Resource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Assets\Fonts\JetBrainsMono-Medium.ttf" />
    <Resource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />
  </ItemGroup>

  <Target Name="BuildM2Adapter" BeforeTargets="PrepareForBuild">
    <Exec Command="cmake -S &quot;$(RepositoryRoot)&quot; -B &quot;$(M2AdapterBuildDirectory)&quot; -A x64" />
    <Exec Command="cmake --build &quot;$(M2AdapterBuildDirectory)&quot; --config $(Configuration) --target A0CameraStitcher.M2Adapter -- /m:1" />
    <Error Condition="!Exists('$(M2AdapterSourcePath)')" Text="A0CameraStitcher.M2Adapter.exe was not produced." />
  </Target>
</Project>

<Window x:Class="A0CameraStitcher.M3.OperatorShell.HardwareSingleCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A0 Camera Stitcher — HARDWARE / 一台構成"
        AutomationProperties.Name="A0 Camera Stitcher HARDWARE SingleCamera operator window"
        Width="1260" Height="860" MinWidth="1020" MinHeight="700"
        Background="#FFF4F6F8" FontFamily="Yu Gothic UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,14" Background="#FF173E5E">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" MaxWidth="520">
                    <TextBlock Text="{Binding ActivityText}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Right" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding AgentAvailabilityText}" Foreground="#FFD4E9F8" TextAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="HARDWARE / 実機1台" Foreground="White" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="SingleCameraを明示選択済み — 接続台数から推定・自動降格しません" Foreground="#FFD4E9F8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="18,10" Background="White" BorderBrush="#FFD7DDE3" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="対象カメラ" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CameraAliases}" SelectedItem="{Binding SelectedCamera}"
                          IsEnabled="{Binding CanSelectCamera}" Width="150" HorizontalAlignment="Left"
                          AutomationProperties.Name="一台構成で使用する登録済みカメラalias" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedCameraDescription}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="安全確認" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="各項目をオペレーターが確認してください。撮影開始時に3項目をtransactionへ固定します。" Margin="0,5,0,10" />
                            <CheckBox Content="物理シャッターと他のカメラアプリを使わず、Camera Agentを排他使用する"
                                      IsChecked="{Binding ExclusiveCameraControlConfirmed}" IsEnabled="{Binding CanChangeConfirmations}"
                                      Margin="0,4" AutomationProperties.Name="camera control排他使用を確認" />
                            <CheckBox Content="選択したD810の専用カードがsingle-slot spoolで、payload objectが0件である"
                                      IsChecked="{Binding DedicatedSpoolScopeConfirmed}" IsEnabled="{Binding CanChangeConfirmations}"
                                      Margin="0,4" AutomationProperties.Name="専用empty spoolを確認" />
                            <CheckBox Content="PC原画像の検証後、今回復元したexact objectだけを削除することを確認した"
                                      IsChecked="{Binding ExactObjectDeleteConfirmed}" IsEnabled="{Binding CanChangeConfirmations}"
                                      Margin="0,4" AutomationProperties.Name="exact object delete契約を確認" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="read-only状態確認" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ReadinessSummary}" FontSize="18" FontWeight="Bold" />
                            </DockPanel>
                            <TextBlock Text="{Binding ReadinessDetail}" Margin="0,8,0,10" AutomationProperties.LiveSetting="Polite" />
                            <Border Padding="9" Margin="0,0,0,10" Background="#FFF1F3F5">
                                <TextBlock Text="{Binding ObservedSettingsText}" AutomationProperties.Name="read-only observed camera settings" />
                            </Border>
                            <Button Content="状態を確認" Command="{Binding CheckReadinessCommand}" IsEnabled="{Binding CanCheckReadiness}"
                                    HorizontalAlignment="Left" AutomationProperties.Name="一台実機のread-only readinessを確認" />
                            <Button Content="観測値を30日プロファイルとして承認" Command="{Binding ApproveProfileCommand}"
                                    IsEnabled="{Binding CanApproveProfile}" HorizontalAlignment="Left"
                                    AutomationProperties.Name="CAM-Aのread-only設定を一台用profileとして承認" />
                            <TextBlock Text="設定値は表示・照合のみ。カメラ設定writeは実装していません。" Foreground="#FF56616B" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="継続Live View" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding LiveViewSummary}" Margin="0,7,0,9" />
                            <Border Height="250" Background="#FF1D252C" BorderBrush="#FF2673A5" BorderThickness="2" Padding="8">
                                <Grid>
                                    <TextBlock Text="未取得 / プレビューは原画像ではありません" Foreground="#FFE6EEF4"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="継続Live Viewを開始"
                                        Command="{Binding StartContinuousLiveViewCommand}"
                                        IsEnabled="{Binding CanStartContinuousLiveView}"
                                        AutomationProperties.Name="一台実機の継続Live Viewを開始" />
                                <Button Grid.Column="2" Content="継続Live Viewを停止"
                                        Command="{Binding StopContinuousLiveViewCommand}"
                                        IsEnabled="{Binding CanStopContinuousLiveView}"
                                        AutomationProperties.Name="継続Live Viewを停止してSDKをclose" />
                            </Grid>
                            <TextBlock Text="previewはメモリ内だけで表示します。撮影時は先に停止・SDK closeを確認し、撮影成功後だけ再開します。"
                                       Foreground="#FF56616B" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="撮影" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="1操作で選択カメラを一回だけ撮影し、PC original永続化とexact cleanupまで実行します。" Margin="0,6,0,10" />
                            <Button Content="選択した1台を撮影" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}"
                                    Padding="18,13" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="安全確認済みの一台実機transactionを一回開始" />
                            <Button Content="未確定transactionの結果を確認" Command="{Binding RecoverTransactionCommand}"
                                    IsEnabled="{Binding CanRecoverTransaction}" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="同一transactionの結果だけを再照会し再撮影しない" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Padding="14" Background="#FFFFE8E8" BorderBrush="#FFB3261E" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="赤 / Blocker" FontWeight="Bold" Foreground="#FF8E1712" />
                            <TextBlock Text="{Binding BlockerText}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,10,0,0" Padding="14" Background="#FFFFF4D6" BorderBrush="#FFB77900" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="黄 / Caution" FontWeight="Bold" Foreground="#FF774E00" />
                            <TextBlock Text="{Binding CautionText}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,10,0,0" Padding="14" Background="#FFE8F2FF" BorderBrush="#FF2563A6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="青 / Info" FontWeight="Bold" Foreground="#FF174E87" />
                            <TextBlock Text="{Binding InfoText}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="結果" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Transaction" FontWeight="Bold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastTransactionId}" />
                                <TextBlock Grid.Row="1" Text="撮影" FontWeight="Bold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureSummary}" />
                                <TextBlock Grid.Row="2" Text="保持原画像" FontWeight="Bold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RetainedOriginalSummary}" />
                                <TextBlock Grid.Row="3" Text="合成" FontWeight="Bold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StitchSummary}" />
                                <TextBlock Grid.Row="4" Text="保存" FontWeight="Bold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExportSummary}" />
                                <TextBlock Grid.Row="5" Text="出力先" FontWeight="Bold" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastExportPath}" />
                            </Grid>
                            <Button Content="単体原画像を保存" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"
                                    Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="検証済み単体原画像をbyte identicalで明示保存" />
                            <Button Content="再合成（SingleCameraでは対象外）" IsEnabled="False" HorizontalAlignment="Stretch" />
                            <Button Content="新しい撮影を準備" Command="{Binding PrepareNewCaptureCommand}"
                                    IsEnabled="{Binding CanPrepareNewCapture}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="保存先" FontWeight="Bold" />
                            <TextBlock Text="{Binding ExportDirectoryDisplay}" Margin="0,5,0,8" />
                            <Button Content="保存先を選択" Click="OnChooseExportDirectory"
                                    IsEnabled="{Binding CanChangeExportDirectory}" HorizontalAlignment="Left"
                                    AutomationProperties.Name="ローカル固定ドライブ上の保存先を選択" />
                            <TextBlock Text="Camera Agent" FontWeight="Bold" />
                            <TextBlock Text="{Binding AgentExecutablePath}" Margin="0,5,0,8" />
                            <Expander Header="技術情報（redacted）">
                                <TextBlock Text="{Binding TechnicalDetail}" Padding="8" Background="#FFF1F3F5" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

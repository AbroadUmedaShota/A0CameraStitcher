<Window x:Class="A0CameraStitcher.M3.OperatorShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A0 Camera Stitcher — SIMULATED / 実機未接続"
        AutomationProperties.Name="A0 Camera Stitcher SIMULATED operator shell 実機未接続"
        Width="1440" Height="920" MinWidth="1120" MinHeight="740"
        Background="#FFF4F6F8" FontFamily="Yu Gothic UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,13" Background="#FF7A1B1B"
                AutomationProperties.Name="SIMULATED 実機未接続 常設警告">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding OverallStateText}" Foreground="White" FontSize="19" FontWeight="Bold" TextAlignment="Right" />
                    <TextBlock Text="{Binding ActivityText}" Foreground="#FFFFD7D7" TextAlignment="Right" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding BannerText}" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="実カメラ・Nikon SDK・WPD・USBへ接続しない操作設計検証用です。" Foreground="#FFFFEAEA" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 状態チップ行: モード / Ready・撮影可否 / SIMULATED -->
        <Border Grid.Row="1" Padding="18,8" Background="#FFEFF2F5" BorderBrush="#FFD7DDE3" BorderThickness="0,0,0,1"
                AutomationProperties.Name="状態チップ行 モード Ready 撮影可否 SIMULATED">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" BorderBrush="#FFB7C0C9" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="モード " Foreground="#FF56616B" FontWeight="Bold" />
                        <TextBlock Text="{Binding SelectedOperatingMode}" FontWeight="Bold"
                                   AutomationProperties.Name="状態チップ 現在の運用構成モード" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#FFB7C0C9" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,0,10,0">
                    <TextBlock Text="{Binding ReadyStatusChipText}" FontWeight="Bold"
                               AutomationProperties.Name="状態チップ Ready状態と撮影可否" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Border Background="#FF7A1B1B" BorderBrush="#FF7A1B1B" BorderThickness="1" CornerRadius="12" Padding="12,4">
                    <TextBlock Text="{Binding BannerText}" Foreground="White" FontWeight="Bold"
                               AutomationProperties.Name="状態チップ 実行環境 SIMULATED表示" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="18,10" Background="White" BorderBrush="#FFD7DDE3" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="排他使用" Foreground="#FF56616B" />
                    <TextBlock Text="{Binding SafetyAckText}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="リグプロファイル" Foreground="#FF56616B" />
                    <TextBlock Text="{Binding ProfileText}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="明示export先（fixed-local folder）" Foreground="#FF56616B" />
                    <TextBox Text="{Binding FixedLocalExportDirectory, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanChangeExportDirectory}"
                             AutomationProperties.Name="操作者選択fixed-local export folder" />
                    <TextBlock Text="{Binding OutputDirectory}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="同意する" Command="{Binding AcceptSafetyCommand}"
                            AutomationProperties.Name="物理シャッターと他アプリを使わないことに同意" />
                    <Button Content="同意しない" Command="{Binding DeclineSafetyCommand}"
                            AutomationProperties.Name="排他使用へ同意しない" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="3" Margin="18" Background="Transparent" BorderThickness="0" TabStripPlacement="Left">
            <TabItem Header="撮影ダッシュボード" AutomationProperties.Name="撮影ダッシュボード">
                <Grid Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ステージ（左カラム・可変幅・ライブビュー/合成プレビュー） -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Left" Text="ステージ" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <ComboBox DockPanel.Dock="Right" Width="170" HorizontalAlignment="Right"
                                          ItemsSource="{Binding StageModeOptions}" SelectedItem="{Binding SelectedStageMode}"
                                          IsEnabled="{Binding CanChangeStageMode}"
                                          AutomationProperties.Name="ステージ表示モード切替 CAM-A live CAM-B live 合成プレビュー" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Margin="0,10,0,10" Foreground="#FF174E87" FontWeight="SemiBold"
                                       Text="{Binding StagePreviewNoteText}"
                                       Visibility="{Binding IsStageLiveNoteVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.Name="Live Viewプレビュー注記 原画像非使用" />

                            <Grid Grid.Row="2" MinHeight="420" Background="#FF1D252C"
                                  AutomationProperties.Name="ステージ表示エリア Simulatedプレースホルダ">

                                <!-- 撮影/合成処理中: Live View停止プレースホルダ -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                            Visibility="{Binding IsStageProcessingPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StageProcessingPlaceholderText}" Foreground="White" FontSize="21" FontWeight="Bold"
                                               TextAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                               AutomationProperties.Name="ステージ 撮影シーケンス実行中プレースホルダ" />
                                    <TextBlock Text="{Binding OverallStateText}" Foreground="#FFB9C2CB" TextAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>

                                <!-- Review: 合成結果ビューア -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                            Visibility="{Binding IsStageReviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Background="#FF2C6B3F" CornerRadius="4" Padding="14,6" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StageReviewBadgeText}" Foreground="White" FontWeight="Bold" FontSize="17"
                                                   AutomationProperties.Name="ステージ表示 合成結果バッジ" />
                                    </Border>
                                    <TextBlock Text="{Binding ProcessingResultLabel}" Foreground="#FFB9C2CB" TextAlignment="Center" Margin="0,12,0,0" FontWeight="Bold" />
                                    <TextBlock Text="{Binding StitchResult}" Foreground="White" TextAlignment="Center" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CaptureResult}" Foreground="#FFB9C2CB" TextAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- CAM-A live / CAM-B live: 当該カメラのフルフレーム表示 -->
                                <Grid Visibility="{Binding IsStageSingleLiveMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Image Source="{Binding StageSingleLiveImage}" Stretch="Uniform" Margin="8"
                                           Visibility="{Binding IsStageSingleLiveImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                           AutomationProperties.Name="ステージ Simulated疑似LVフレーム CAM-A CAM-B フルフレーム" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                                Visibility="{Binding IsStageSingleLivePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding StageSingleLiveAlias}" Foreground="White" FontSize="26" FontWeight="Bold" TextAlignment="Center" />
                                        <TextBlock Text="{Binding StageSingleLiveText}" Foreground="#FFB9C2CB" TextAlignment="Center" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- 合成プレビュー: A0レイアウトマッピング（ライブ側=動画 / 非ライブ側=最終フレーム静止画 + 重複帯） -->
                                <Grid Margin="16"
                                      Visibility="{Binding IsStageCompositePreviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          Visibility="{Binding StageCompositeApplicable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Image Source="{Binding StageCompositeLiveImage}" Stretch="Uniform" Margin="4"
                                               Visibility="{Binding IsStageCompositeLiveImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.Name="ステージ 合成プレビュー ライブ側 Simulated疑似LVフレーム" />
                                        <StackPanel VerticalAlignment="Center"
                                                    Visibility="{Binding IsStageCompositeLivePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding StageCompositeLiveAlias}" Foreground="White" FontWeight="Bold" FontSize="18" TextAlignment="Center" />
                                            <TextBlock Text="ライブ動画（Simulatedプレースホルダ）" Foreground="#FFB9C2CB" TextAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Column="1" Background="#FFDB9A16" CornerRadius="2"
                                            Visibility="{Binding StageCompositeApplicable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding StageCompositeOverlapBandText}" Foreground="#FF1D252C" FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Center" VerticalAlignment="Center"
                                                   AutomationProperties.Name="重複帯 幅pxプレースホルダ値 実測未接続" />
                                    </Border>

                                    <Grid Grid.Column="2"
                                          Visibility="{Binding StageCompositeApplicable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding StageCompositeStillImage}" Stretch="Uniform" Margin="4"
                                               Visibility="{Binding IsStageCompositeStillImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.Name="ステージ 合成プレビュー 非ライブ側 最終フレーム静止画" />
                                        <StackPanel Grid.Row="0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsStageCompositeStillPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding StageCompositeStillAlias}" Foreground="White" FontWeight="Bold" FontSize="18" TextAlignment="Center" />
                                            <TextBlock Text="最終フレーム静止画（Simulatedプレースホルダ）" Foreground="#FFB9C2CB" TextAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Background="#FF33404B" CornerRadius="10" Padding="10,3" Margin="0,10,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StageCompositeFreshnessText}" Foreground="#FFFFD7D7" FontWeight="Bold"
                                                       AutomationProperties.Name="非ライブ側 鮮度バッジ 経過秒" AutomationProperties.LiveSetting="Polite" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="合成対象外（1台構成）" Foreground="White" FontSize="18" FontWeight="Bold"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsSingleCameraMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 右カラム（固定約380px・拡大エリア/フォーカス/アクションゾーンの枠 + 既存機能の暫定配置） -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">

                                <Border Style="{StaticResource InsetStyle}">
                                    <StackPanel>
                                        <TextBlock Text="運用" Style="{StaticResource SectionTitleStyle}" FontSize="17" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="運用構成" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding OperatingModeOptions}" SelectedItem="{Binding SelectedOperatingMode}"
                                                      IsEnabled="{Binding CanChangeOperatingMode}" AutomationProperties.Name="一台または二台の運用構成を明示選択" />
                                        </Grid>
                                        <TextBlock Text="{Binding OperatingModeDescription}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />

                                        <Border Margin="0,10,0,6" Padding="10" Background="White" BorderBrush="#FFD7DDE3" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="CAM-A" FontWeight="Bold" />
                                                <TextBlock Text="{Binding CameraAStatus}" Margin="0,4,0,0" AutomationProperties.Name="CAM-A simulated status" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,0,10" Padding="10" Background="White" BorderBrush="#FFD7DDE3" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="CAM-B" FontWeight="Bold" />
                                                <TextBlock Text="{Binding CameraBStatus}" Margin="0,4,0,0" AutomationProperties.Name="CAM-B simulated status" />
                                            </StackPanel>
                                        </Border>

                                        <DockPanel>
                                            <TextBlock Text="{Binding CameraSelectionLabel}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <ComboBox DockPanel.Dock="Right" Width="88" ItemsSource="{Binding CameraAliases}" SelectedItem="{Binding SelectedCamera}" IsEnabled="{Binding CanSelectCamera}" />
                                        </DockPanel>
                                        <Border Height="96" Margin="0,8,0,8" Padding="10" Background="#FF1D252C" BorderBrush="#FFDB9A16" BorderThickness="2"
                                                AutomationProperties.Name="Simulated Live View placeholder 非実画像">
                                            <TextBlock Text="{Binding LiveViewPlaceholder}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" />
                                        </Border>
                                        <Button Content="{Binding LiveViewButtonText}" Command="{Binding ToggleLiveViewCommand}" IsEnabled="{Binding CanUseLiveView}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InsetStyle}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="設置判定" Style="{StaticResource SectionTitleStyle}" FontSize="17" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SetupStatusText}" FontWeight="Bold" TextAlignment="Right" />
                                        </DockPanel>
                                        <Border Margin="0,8,0,6" Padding="10" Background="#FFFFF7DF" BorderBrush="#FFD29B1B" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="予定する自動補正" FontWeight="Bold" />
                                                <TextBlock Text="{Binding CorrectionText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="10" Background="#FFFFE8E8" BorderBrush="#FFC43A3A" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="必要な物理調整" FontWeight="Bold" />
                                                <TextBlock Text="{Binding PhysicalAdjustmentText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#FFD7DDE3" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="10">
                                    <TextBlock Text="拡大エリア（次期Issueで実装）" Foreground="#FF8A96A3" FontStyle="Italic" TextAlignment="Center"
                                               AutomationProperties.Name="拡大エリア プレースホルダ枠 未実装" />
                                </Border>
                                <Border BorderBrush="#FFD7DDE3" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="10">
                                    <TextBlock Text="フォーカス（次期Issueで実装）" Foreground="#FF8A96A3" FontStyle="Italic" TextAlignment="Center"
                                               AutomationProperties.Name="フォーカス プレースホルダ枠 未実装" />
                                </Border>

                                <Border BorderBrush="#FFB7C0C9" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="10"
                                        AutomationProperties.Name="アクションゾーン 撮影と結果 暫定配置">
                                    <StackPanel>
                                        <TextBlock Text="アクションゾーン" Style="{StaticResource SectionTitleStyle}" FontSize="17" />
                                        <ItemsControl ItemsSource="{Binding ProgressSteps}" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,4,4" Padding="6" MinHeight="56" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="2">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" TextAlignment="Center" FontSize="11" Foreground="{Binding Foreground}" />
                                                            <TextBlock Text="{Binding StatusText}" Margin="0,3,0,0" TextAlignment="Center" FontSize="11" Foreground="{Binding Foreground}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding CaptureButtonText}" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}" Margin="0,10,0,0" Padding="14,10" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" AutomationProperties.Name="確認なしで明示構成の新しい撮影を一回開始" />
                                        <TextBlock Text="{Binding CaptureDisabledReason}" Margin="0,6,0,0" Foreground="#FF6C3B00" AutomationProperties.LiveSetting="Polite" />

                                        <Border Margin="0,12,0,0" Padding="10" Background="White" BorderBrush="#FFD7DDE3" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="結果" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                                                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,10" FontWeight="Bold" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="撮影と失敗の共通結果" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="Transaction" FontWeight="Bold" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastTransactionId}" />
                                                    <TextBlock Grid.Row="1" Text="撮影" FontWeight="Bold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureResult}" />
                                                    <TextBlock Grid.Row="2" Text="保持原画像" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RetainedOriginals}" />
                                                    <TextBlock Grid.Row="3" Text="{Binding ProcessingResultLabel}" FontWeight="Bold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StitchResult}" />
                                                    <TextBlock Grid.Row="4" Text="保存" FontWeight="Bold" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExportResult}" />
                                                    <TextBlock Grid.Row="5" Text="出力先" FontWeight="Bold" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastExportPath}" />
                                                </Grid>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Button Content="fixed-localへ明示export" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" AutomationProperties.Name="確認済み単体原画像または合成結果を明示保存" />
                                                    <Button Content="再合成（別job）" Command="{Binding RestitchCommand}" IsEnabled="{Binding CanRestitch}" />
                                                    <Button Content="新しい撮影を準備" Command="{Binding PrepareNewCaptureCommand}" IsEnabled="{Binding CanPrepareNewCapture}" AutomationProperties.Name="read-only readiness再検査" />
                                                </WrapPanel>
                                                <Expander Header="技術情報（error code・ログ位置）" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding TechnicalDetail}" Padding="8" Background="#FFF1F3F5" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,10,0,0" Padding="10" Background="#FFFFE8E8" BorderBrush="#FFB3261E" BorderThickness="2" AutomationProperties.Name="赤 Blocker警告">
                                            <StackPanel>
                                                <TextBlock Text="赤 / Blocker" FontWeight="Bold" Foreground="#FF8E1712" />
                                                <TextBlock Text="{Binding BlockerText}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Assertive" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,8,0,0" Padding="10" Background="#FFFFF4D6" BorderBrush="#FFB77900" BorderThickness="2" AutomationProperties.Name="黄 Caution警告">
                                            <StackPanel>
                                                <TextBlock Text="黄 / Caution" FontWeight="Bold" Foreground="#FF774E00" />
                                                <TextBlock Text="{Binding CautionText}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,8,0,0" Padding="10" Background="#FFE8F2FF" BorderBrush="#FF2563A6" BorderThickness="1" AutomationProperties.Name="青 Info情報">
                                            <StackPanel>
                                                <TextBlock Text="青 / Info" FontWeight="Bold" Foreground="#FF174E87" />
                                                <TextBlock Text="{Binding InfoText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,8,0,0" Padding="10" Background="#FFF2EDFF" BorderBrush="#FF7157A8" BorderThickness="1" AutomationProperties.Name="No automatic retry warning">
                                            <TextBlock Text="警告 / NO AUTO RETRY / FailedPartialは再開・再試行しません。自動再試行回数は0回固定です。" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="設置・校正" IsEnabled="{Binding CanOpenMaintenance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,0,0" MaxWidth="960" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="設置・校正（SIMULATED）" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="承認済みプロファイルの閾値を使い、補正不要・自動補正範囲内・物理調整必要を検証します。プロファイルを自動更新しません。" Margin="0,6,0,12" />
                                <TextBlock Text="表示シナリオ" FontWeight="Bold" />
                                <ComboBox ItemsSource="{Binding ReadinessDemoOptions}" SelectedItem="{Binding SelectedReadinessDemo}" Width="260" HorizontalAlignment="Left" Margin="0,6,0,12" />
                                <Border Padding="14" Background="#FFF1F3F5"><StackPanel><TextBlock Text="{Binding SetupStatusText}" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding CorrectionText}" Margin="0,6,0,0" /><TextBlock Text="{Binding PhysicalAdjustmentText}" Margin="0,4,0,0" /></StackPanel></Border>
                                <TextBlock Text="Simulated Live View パターン（開発・検証用）" FontWeight="Bold" Margin="0,16,0,0" />
                                <TextBlock Text="正対・傾き（#32 エッジ検出検証用）・ボケ→合焦遷移（#31 ピーキング検証用）を切替できます。ステージのCAM-A/CAM-B live・合成プレビューへ即時反映されます。" Margin="0,4,0,6" Foreground="#FF56616B" TextWrapping="Wrap" MaxWidth="640" />
                                <ComboBox ItemsSource="{Binding SimulatedFramePatternOptions}" SelectedItem="{Binding SelectedSimulatedFramePattern}"
                                          Width="260" HorizontalAlignment="Left" Margin="0,0,0,12"
                                          AutomationProperties.Name="疑似LVフレームソース パターン切替 開発検証用" />
                                <Button Content="校正を開始（未実装・human gate待ち）" IsEnabled="False" Margin="0,14,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="カメラ設定" IsEnabled="{Binding CanOpenMaintenance}">
                <StackPanel Margin="18,0,0,0" MaxWidth="960" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="カメラ設定（read-only）" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="write契約が実機証拠で承認されるまで、設定変更は実装しません。FX / JPEG Fine L / 固定露出 / 固定フォーカス / 固定WB / Auto ISOなし / VRなしを確認対象とします。" Margin="0,8,0,12" />
                            <DataGrid ItemsSource="{Binding CameraSettingRows}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Height="230" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="設定" Binding="{Binding Setting}" Width="120" />
                                    <DataGridTextColumn Header="要求profile" Binding="{Binding RequiredProfile}" Width="2*" />
                                    <DataGridTextColumn Header="CAM-A" Binding="{Binding CameraA}" Width="*" />
                                    <DataGridTextColumn Header="CAM-B" Binding="{Binding CameraB}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="設定を書き込む（禁止）" IsEnabled="False" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="保存・診断" IsEnabled="{Binding CanOpenMaintenance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,0,0" MaxWidth="960" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="保存・診断（SIMULATED）" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="失敗箇所の表示を確認します。撮影開始条件を満たす場合だけ実行でき、カード削除・format・vendor operation 0x9207は呼びません。" Margin="0,6,0,12" />
                                <DockPanel LastChildFill="False">
                                    <ComboBox Width="250" ItemsSource="{Binding DiagnosticScenarios}" SelectedItem="{Binding SelectedDiagnosticScenario}" Margin="0,0,8,8" />
                                    <Button Content="診断シナリオを実行" Command="{Binding DiagnosticCommand}" IsEnabled="{Binding CanCapture}" />
                                </DockPanel>
                                <TextBlock Text="常時禁止: 同一transactionの再開・再試行 / 過去CAM-Bとの自動ペア / SDK・WPD重複 / 同時二台Live View / previewの原画像利用 / bulk delete / format / 0x9207 / PC原本検証前の削除 / active transaction中の変更 / 原画像の上書き・自動削除" Margin="0,10,0,0" FontWeight="Bold" />
                                <TextBlock Text="{Binding TechnicalDetail}" Margin="0,12,0,0" Padding="12" Background="#FFF1F3F5" />
                                <TextBlock Text="作成済みtransaction数（連打防止確認）" FontWeight="Bold" Margin="0,12,0,0" /><TextBlock Text="{Binding TransactionStartCount}" FontSize="22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

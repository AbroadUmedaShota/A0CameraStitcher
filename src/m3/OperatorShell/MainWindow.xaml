<Window x:Class="A0CameraStitcher.M3.OperatorShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:A0CameraStitcher.M3.OperatorShell.Converters"
        xmlns:controls="clr-namespace:A0CameraStitcher.M3.OperatorShell.Controls"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="{Binding WindowAutomationName}"
        Width="1600" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DesktopBrush}"
        FontFamily="{DynamicResource SansFontFamily}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 撮影画面は 1920×1080 の固定キャンバスとして組み、ウィンドウ側では等比縮小だけを行う。
         操作者ごとに画面サイズが違ってもレイアウトが崩れず、要素の相対位置が撮影手順の記憶と
         一致し続けるため。縮小で生じる余白はマスク色で塗り、スクロールは発生させない。 -->
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0: タイトルバーはキャンバス内にあり縮小率で実高が変わるため、
             物理座標で効く OS のキャプション判定は使わず、ドラッグを自前で処理する。 -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ダークテーマは MainWindow だけに適用する。Application.Resources へ入れると
                     実機1台画面・起動モード選択画面の既存配色まで巻き込むため。 -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:FractionToMarginConverter x:Key="FractionToMarginConverter" />
            <converters:StringEqualsVisibilityConverter x:Key="StringEqualsVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>


    <Grid Background="{StaticResource DesktopBrush}">
        <Viewbox Stretch="Uniform">
            <Grid x:Name="RootCanvas" Width="1920" Height="1080" Background="{StaticResource WindowBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- ============================ タイトルバー ============================ -->
                <Border Grid.Row="0" Background="{StaticResource BarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="A0 Camera Stitcher" Margin="14,0,0,0"
                                   FontSize="{StaticResource FontSizeSection}" FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <Border DockPanel.Dock="Left" Style="{StaticResource ChipStyle}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SelectedOperatingMode}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource FontSizeCompact}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       AutomationProperties.Name="状態チップ 現在の運用構成モード" />
                        </Border>

                        <!-- 総合状態バッジ。通知と同時に2回明滅させて、状態が変わったことを気づかせる。 -->
                        <Border x:Name="StateBadge" DockPanel.Dock="Left" Margin="8,0,0,0" Height="22" Padding="10,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrightBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OverallStateText}" Margin="6,0,0,0"
                                           FontSize="{StaticResource FontSizeCompact}" FontWeight="Medium"
                                           Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"
                                           AutomationProperties.Name="状態チップ Ready状態と撮影可否"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <!-- 実行環境と検証範囲は常時見えていなければならない。畳まない・隠さない。 -->
                        <Border DockPanel.Dock="Left" Margin="8,0,0,0" Height="22" Padding="9,0" VerticalAlignment="Center"
                                Background="{StaticResource CautionBadgeBrush}" BorderBrush="{StaticResource CautionBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="{StaticResource FontSizeCompact}" FontWeight="Bold"
                                       Foreground="{StaticResource CautionBrush}"
                                       AutomationProperties.Name="{Binding EnvironmentStatusAutomationName}" />
                        </Border>

                        <!-- 同意を見送った場合の復帰口。未同意の間だけ出す。 -->
                        <Button DockPanel.Dock="Left" Margin="8,0,0,0" Padding="9,0" MinHeight="22" VerticalAlignment="Center"
                                Content="{Binding SafetyAckText}" Command="{Binding ShowConsentCommand}"
                                FontSize="{StaticResource FontSizeCompact}"
                                Foreground="{StaticResource CautionBrush}" BorderBrush="{StaticResource CautionBorderBrush}"
                                Visibility="{Binding IsSafetyAckPending, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="排他同意が未了 押すと同意画面を開く" />

                        <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButtonStyle}"
                                Content="✕" Click="CloseWindow_Click"
                                AutomationProperties.Name="ウィンドウを閉じる" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButtonStyle}"
                                Content="▢" Click="MaximizeWindow_Click"
                                AutomationProperties.Name="ウィンドウを最大化または元に戻す" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButtonStyle}"
                                Content="─" Click="MinimizeWindow_Click"
                                AutomationProperties.Name="ウィンドウを最小化" />

                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProfileText}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   AutomationProperties.Name="設置プロファイル 版と期限" />
                    </DockPanel>
                </Border>

                <!-- ============================ メニューバー ============================ -->
                <!-- メニューバー（issue #34）: ヘッダー直下・左ナビ廃止に伴う低頻度グローバル操作の集約先。
                     ファイル/カメラ/表示/ツール/ヘルプの5項目のみで構成し、編集メニューは設置しない
                     （原本は無加工・byte-identical保存が契約のため画像編集機能が設計上存在しない —
                     docs/OPERATOR_UI_SPEC.md メニューバー節）。各項目は既存の
                     OperatorActionAvailability連動プロパティ（CanChangeOperatingMode等）へそのまま
                     束縛し、メニュー経由の操作が状態ゲートの抜け穴にならないようにする。 -->
                <Border Grid.Row="1" Background="{StaticResource MenuBarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <Menu DockPanel.Dock="Left" Margin="8,0,0,0"
                              AutomationProperties.Name="{Binding MenuBarAutomationName}">
                            <MenuItem Header="ファイル(_F)" AutomationProperties.Name="ファイルメニュー">
                                <MenuItem Header="保存先を指定(_L)..." Click="ChooseExportDirectory_Click"
                                          IsEnabled="{Binding CanChangeExportDirectory}"
                                          Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                          AutomationProperties.Name="ファイル 保存先を指定 フォルダ選択ダイアログを開く このPC内のみ" />
                                <MenuItem Header="このPCのフォルダへ保存(_E)" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"
                                          Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                          AutomationProperties.Name="ファイル このPCのフォルダへ保存 確認済みの単体原画像または合成結果を保存" />
                                <Separator />
                                <MenuItem Header="終了(_X)" Click="ExitMenuItem_Click"
                                          AutomationProperties.Name="ファイル 終了 アプリケーションを終了" />
                            </MenuItem>
                            <MenuItem Header="カメラ(_C)" AutomationProperties.Name="カメラメニュー 運用構成選択 カメラ設定read-only表示 identity状態 readiness再検査">
                                <MenuItem Header="運用構成(_M)" AutomationProperties.Name="カメラ 運用構成 SingleCamera DualCameraの選択">
                                    <MenuItem Header="1台構成（SingleCamera）" IsCheckable="True"
                                              IsChecked="{Binding IsSingleCameraModeChecked, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChangeOperatingMode}"
                                              AutomationProperties.Name="運用構成 1台構成 SingleCameraを選択" />
                                    <MenuItem Header="2台構成（DualCamera）" IsCheckable="True"
                                              IsChecked="{Binding IsDualCameraModeChecked, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChangeOperatingMode}"
                                              AutomationProperties.Name="運用構成 2台構成 DualCameraを選択" />
                                </MenuItem>
                                <MenuItem Header="カメラ設定を表示（read-only）(_S)" Command="{Binding ShowCameraSettingsCommand}" IsEnabled="{Binding CanOpenMaintenance}"
                                          AutomationProperties.Name="カメラ カメラ設定read-only表示 保守画面へ移動" />
                                <!-- 観測値の30日profile承認: このSIMULATEDシェル（OperatorShellViewModel）には
                                     承認フローそのものが実装されていない（30日profile承認は別ウィンドウの
                                     HardwareSingleCameraViewModelが保持する機能）。存在しない機能を偽装せず、
                                     既存コードの慣例（校正未実装ボタン等）と同じ disabled プレースホルダとして
                                     構成のみ用意する。 -->
                                <MenuItem Header="観測値の30日profile承認（本シェルでは未実装）" IsEnabled="False"
                                          AutomationProperties.Name="カメラ 観測値の30日profile承認 本画面では未実装" />
                                <MenuItem Header="{Binding DualCameraIdentityStatusText}" IsEnabled="False"
                                          AutomationProperties.Name="カメラ identity状態 読み取り専用表示" />
                                <!-- Simulationでは機体照合の流れだけを確認する表示切替。
                                     HardwareDualでは実機割当そのものだが、起動時から必須なのでこの項目は無効になる。 -->
                                <MenuItem Header="{Binding BindingMenuHeader}" Command="{Binding ShowBindingDemoCommand}"
                                          AutomationProperties.Name="{Binding BindingMenuAutomationName}" />
                                <Separator />
                                <MenuItem Header="readiness再検査(_R)" Command="{Binding PrepareNewCaptureCommand}" IsEnabled="{Binding CanPrepareNewCapture}"
                                          AutomationProperties.Name="カメラ readiness再検査 read-only 新しい撮影を準備" />
                            </MenuItem>
                            <MenuItem Header="表示(_V)" AutomationProperties.Name="表示メニュー オーバーレイトグル 拡大エリア倍率 傾き読み値表示切替"
                                      Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <MenuItem Header="方眼グリッド" IsCheckable="True" IsChecked="{Binding IsGridOverlayEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="表示 方眼グリッド表示切替" />
                                <MenuItem Header="トンボ" IsCheckable="True" IsChecked="{Binding IsTombOverlayEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="表示 トンボ表示切替" />
                                <MenuItem Header="重複帯" IsCheckable="True" IsChecked="{Binding IsOverlapBandOverlayEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="表示 重複帯表示切替" />
                                <MenuItem Header="安全マージン" IsCheckable="True" IsChecked="{Binding IsSafeMarginOverlayEnabled, Mode=TwoWay}"
                                          AutomationProperties.Name="表示 安全マージン表示切替" />
                                <Separator />
                                <MenuItem Header="拡大エリア倍率" AutomationProperties.Name="表示 拡大エリア倍率切替 100パーセント 200パーセント">
                                    <MenuItem Header="100%" IsCheckable="True"
                                              IsChecked="{Binding IsLoupeZoom100Checked, Mode=TwoWay}"
                                              AutomationProperties.Name="拡大エリア倍率 100パーセントを選択" />
                                    <MenuItem Header="200%" IsCheckable="True"
                                              IsChecked="{Binding IsLoupeZoom200Checked, Mode=TwoWay}"
                                              AutomationProperties.Name="拡大エリア倍率 200パーセントを選択" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="傾き読み値の表示" IsCheckable="True" IsChecked="{Binding IsTiltReadingVisible, Mode=TwoWay}"
                                          AutomationProperties.Name="表示 傾き読み値の表示切替" />
                            </MenuItem>
                            <MenuItem Header="ツール(_T)" AutomationProperties.Name="ツールメニュー 設置校正 再合成別job 保存診断"
                                      Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <MenuItem Header="設置・校正(_S)" Command="{Binding ShowSetupCommand}" IsEnabled="{Binding CanOpenMaintenance}"
                                          AutomationProperties.Name="ツール 設置・校正 保守画面へ移動" />
                                <MenuItem Header="再合成（別job）(_R)" Command="{Binding RestitchCommand}" IsEnabled="{Binding CanRestitch}"
                                          AutomationProperties.Name="ツール 再合成 別job" />
                                <MenuItem Header="保存・診断(_D)" Command="{Binding ShowDiagnosticsCommand}" IsEnabled="{Binding CanOpenMaintenance}"
                                          AutomationProperties.Name="ツール 保存・診断 保守画面へ移動" />
                            </MenuItem>
                            <MenuItem Header="ヘルプ(_H)" AutomationProperties.Name="ヘルプメニュー 技術情報 バージョン">
                                <MenuItem Header="技術情報（error code・ログ位置）(_T)" Click="ShowTechnicalDetail_Click"
                                          AutomationProperties.Name="ヘルプ 技術情報 error code ログ位置" />
                                <MenuItem Header="バージョン(_V)" Click="ShowVersion_Click"
                                          AutomationProperties.Name="ヘルプ バージョン" />
                            </MenuItem>
                        </Menu>

                        <!-- 表示設定のリセット。1回目は確認待ち、2回目で確定する。 -->
                        <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="10,0" MinHeight="22" VerticalAlignment="Center"
                                Content="{Binding ResetButtonText}" Command="{Binding ResetViewCommand}"
                                Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                FontSize="{StaticResource FontSizeBody}"
                                AutomationProperties.Name="表示設定のリセット 2回押しで確定">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResetArmed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CautionBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 構図グリッドの分割数。案件ごとに割り付けが違うので3分割固定にしない。 -->
                        <ToggleButton x:Name="GridSettingsToggle" DockPanel.Dock="Right" Margin="0,0,8,0" MinHeight="22"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                      AutomationProperties.Name="グリッド設定を開く 列数と行数の指定">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Face" Background="{StaticResource ControlSunkenBrush}"
                                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                        Padding="10,0">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Face" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                                        <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                <Run Text="グリッド " /><Run Text="{Binding GridDivisionText, Mode=OneWay}" /><Run Text="  ⌄" />
                            </TextBlock>
                        </ToggleButton>

                        <Popup PlacementTarget="{Binding ElementName=GridSettingsToggle}" Placement="Bottom"
                               HorizontalOffset="-190" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=GridSettingsToggle, Mode=TwoWay}">
                            <Border Width="304" Padding="12" Margin="0,0,8,8"
                                    Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1" Effect="{StaticResource DropdownShadow}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="構図グリッド" FontWeight="Medium"
                                                   FontSize="{StaticResource FontSizeLabel}" />
                                        <CheckBox DockPanel.Dock="Right" Content="表示する" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsGridOverlayEnabled, Mode=TwoWay}"
                                                  FontSize="{StaticResource FontSizeCompact}"
                                                  AutomationProperties.Name="方眼グリッドの表示切替" />
                                    </DockPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="3×3" Command="{Binding GridPreset3Command}"
                                                Margin="0,0,1,0" FontFamily="{StaticResource MonoFontFamily}" />
                                        <Button Grid.Column="1" Content="4×4" Command="{Binding GridPreset4Command}"
                                                Margin="0,0,1,0" FontFamily="{StaticResource MonoFontFamily}" />
                                        <Button Grid.Column="2" Content="5×5" Command="{Binding GridPreset5Command}"
                                                FontFamily="{StaticResource MonoFontFamily}" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="列" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Grid.Column="1" Text="{Binding GridColumns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="グリッドの列数 1から24" />
                                        <TextBlock Grid.Column="2" Text="行" VerticalAlignment="Center" Margin="10,0,8,0"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Grid.Column="3" Text="{Binding GridRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="グリッドの行数 1から24" />
                                    </Grid>
                                    <TextBlock Text="1〜24 で指定します。位置合わせの目安で、撮影の可否には使いません。"
                                               Margin="0,10,0,0" Style="{StaticResource MutedTextStyle}"
                                               FontSize="{StaticResource FontSizeCompact}" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Style="{StaticResource MonoTextStyle}"
                                   Text="{Binding ActivityText}" TextTrimming="CharacterEllipsis" MaxWidth="300"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="現在の進行状況" />
                    </DockPanel>
                </Border>

                <!-- ============================ コンテンツ ============================ -->
                <Grid Grid.Row="2">

                    <!-- 撮影ダッシュボード -->
                    <Grid Visibility="{Binding SelectedPage, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Dashboard}"
                          AutomationProperties.Name="撮影ダッシュボード">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="372" />
                        </Grid.ColumnDefinitions>

                        <!-- ==================== 左カラム: ライブ表示とステージ ==================== -->
                        <Grid Grid.Column="0" Background="{StaticResource LeftColumnBrush}" Margin="0">
                            <Grid Margin="16,14,16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 表示切替行 -->
                                <DockPanel Grid.Row="0" LastChildFill="False"
                                           Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock DockPanel.Dock="Left" Text="ライブ表示" Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap"
                                               Text="ターゲットはドラッグで移動（画面上=粗い ／ 拡大内=細かい）" />

                                    <ListBox DockPanel.Dock="Right" Style="{StaticResource SegmentListStyle}"
                                             ItemsSource="{Binding StageModeOptions}" SelectedItem="{Binding SelectedStageMode}"
                                             IsEnabled="{Binding CanChangeStageMode}"
                                             AutomationProperties.Name="ステージ表示モード切替 CAM-A live CAM-B live 合成プレビュー" />
                                    <TextBlock DockPanel.Dock="Right" Text="表示:" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />

                                    <ListBox DockPanel.Dock="Right" Style="{StaticResource MonoSegmentListStyle}" Margin="0,0,14,0"
                                             ItemsSource="{Binding LoupeZoomOptions}" SelectedItem="{Binding SelectedLoupeZoom}"
                                             AutomationProperties.Name="拡大エリア 倍率切替 100パーセント 200パーセント" />
                                    <TextBlock DockPanel.Dock="Right" Text="拡大:" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />

                                    <Button DockPanel.Dock="Right" Margin="0,0,14,0" Padding="10,4"
                                            Content="{Binding LiveViewButtonText}" Command="{Binding ToggleLiveViewCommand}"
                                            IsEnabled="{Binding CanUseLiveView}"
                                            AutomationProperties.Name="ライブ表示の開始と停止" />
                                </DockPanel>

                                <TextBlock Grid.Row="0" Text="撮影・回収のみ（実機プレビューは機体照合画面で確認）"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Visibility="{Binding ShowCaptureRecoveryOnlyInstruction, Converter={StaticResource BoolToVisibilityConverter}}"
                                           AutomationProperties.Name="撮影回収専用モード 実機プレビューは機体照合画面だけで使用" />

                                <!-- カメラ状態行: 接続・機体照合・設定・カードの確認結果を常時見せる -->
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Padding="10,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="CAM-A" FontWeight="Medium"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Margin="10,0,0,0" Text="{Binding CameraAStatus}" VerticalAlignment="Center"
                                                       Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.Name="CAM-A 状態表示" />
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Padding="10,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="CAM-B" FontWeight="Medium"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Margin="10,0,0,0" Text="{Binding CameraBStatus}" VerticalAlignment="Center"
                                                       Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.Name="CAM-B 状態表示" />
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <!-- ==================== ステージ ==================== -->
                                <Border Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource StageBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid x:Name="StageDisplayArea" ClipToBounds="True"
                                          AutomationProperties.Name="ステージ表示エリア プレビューと結果の表示">

                                        <Grid Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- 撮影/合成処理中の表示は、下の進捗オーバーレイが一枚で受け持つ。
                                             ここに同じ文言を置くと、半透明のオーバーレイ越しに二重像になる。 -->

                                        <!-- Review: 合成結果ビューア -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                                    Visibility="{Binding IsStageReviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Background="{StaticResource AccentBrush}" Padding="14,6" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StageReviewBadgeText}" FontWeight="Bold"
                                                           FontSize="{StaticResource FontSizeSection}"
                                                           Foreground="{StaticResource AccentOnStrongBrush}"
                                                           AutomationProperties.Name="ステージ表示 合成結果バッジ" />
                                            </Border>
                                            <TextBlock Text="{Binding ProcessingResultLabel}" Margin="0,12,0,0" TextAlignment="Center"
                                                       FontWeight="Medium" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding StitchResult}" TextAlignment="Center" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CaptureResult}" TextAlignment="Center" Margin="0,4,0,0"
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>

                                        <!-- CAM-A live / CAM-B live: 当該カメラのフルフレーム表示 -->
                                        <Grid Visibility="{Binding IsStageSingleLiveMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Background="{StaticResource StageHatchBrush}"
                                                    Visibility="{Binding IsStageSingleLivePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Image Source="{Binding StageSingleLiveImage}" Stretch="Uniform" Margin="8"
                                                   Visibility="{Binding IsStageSingleLiveImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   AutomationProperties.Name="ステージ 模擬ライブ表示のフレーム CAM-A CAM-B 全画面" />
                                            <Image Source="{Binding StageSingleLivePeakingOverlay}" Stretch="Uniform" Margin="8" IsHitTestVisible="False"
                                                   Visibility="{Binding IsStageSingleLivePeakingOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   AutomationProperties.Name="ステージ フォーカスピーキング エッジ強調オーバーレイ preview専用" />
                                            <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="10,6"
                                                    Background="{StaticResource StageChipBrush}"
                                                    Visibility="{Binding IsStageSingleLivePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StageSingleLiveAlias}" TextAlignment="Center"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="{StaticResource FontSizeBase}"
                                                               Foreground="{StaticResource TextStageBrush}" />
                                                    <TextBlock Text="{Binding StageSingleLiveText}" TextAlignment="Center" Margin="0,6,0,0"
                                                               Style="{StaticResource MutedTextStyle}" MaxWidth="420" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 合成プレビュー: A0レイアウトマッピング（ライブ側=動画 / 非ライブ側=最終フレーム静止画 + 重複帯） -->
                                        <Grid Margin="16"
                                              Visibility="{Binding IsStageCompositePreviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0"
                                                  Visibility="{Binding StageCompositeApplicable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border Background="{StaticResource StageHatchBrush}"
                                                        Visibility="{Binding IsStageCompositeLivePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Image Source="{Binding StageCompositeLiveImage}" Stretch="Uniform" Margin="4"
                                                       Visibility="{Binding IsStageCompositeLiveImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.Name="ステージ 合成プレビュー ライブ側 Simulated疑似LVフレーム" />
                                                <Image Source="{Binding StageCompositeLivePeakingOverlay}" Stretch="Uniform" Margin="4" IsHitTestVisible="False"
                                                       Visibility="{Binding IsStageCompositeLivePeakingOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.Name="ステージ 合成プレビュー ライブ側 フォーカスピーキング エッジ強調オーバーレイ preview専用" />
                                                <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="10,6"
                                                        Background="{StaticResource StageChipBrush}"
                                                        Visibility="{Binding IsStageCompositeLivePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StageCompositeLiveAlias}" TextAlignment="Center"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   Foreground="{StaticResource TextStageBrush}" />
                                                        <TextBlock Text="ライブ動画（Simulatedプレースホルダ）" TextAlignment="Center" Margin="0,6,0,0"
                                                                   Style="{StaticResource MutedTextStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Column="1" Background="{StaticResource OverlapBandFillBrush}"
                                                    BorderBrush="{StaticResource OverlapBandEdgeBrush}" BorderThickness="1,0"
                                                    Visibility="{Binding IsOverlapBandVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <!-- 帯は縦に細いので、ラベルは横書きのまま90度倒して読ませる。 -->
                                                <TextBlock Text="{Binding StageCompositeOverlapBandText}" TextWrapping="NoWrap"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource OverlapBandTextBrush}"
                                                           AutomationProperties.Name="重複帯 幅pxプレースホルダ値 実測未接続">
                                                    <TextBlock.LayoutTransform>
                                                        <RotateTransform Angle="90" />
                                                    </TextBlock.LayoutTransform>
                                                </TextBlock>
                                            </Border>

                                            <Grid Grid.Column="2"
                                                  Visibility="{Binding StageCompositeApplicable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{StaticResource StageHatchBrush}"
                                                        Visibility="{Binding IsStageCompositeStillPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Image Grid.Row="0" Source="{Binding StageCompositeStillImage}" Stretch="Uniform" Margin="4"
                                                       Visibility="{Binding IsStageCompositeStillImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.Name="ステージ 合成プレビュー 非ライブ側 最終フレーム静止画" />
                                                <Border Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="10,6"
                                                        Background="{StaticResource StageChipBrush}"
                                                        Visibility="{Binding IsStageCompositeStillPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StageCompositeStillAlias}" TextAlignment="Center"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   Foreground="{StaticResource TextStageBrush}" />
                                                        <TextBlock Text="最終フレーム静止画（Simulatedプレースホルダ）" TextAlignment="Center" Margin="0,6,0,0"
                                                                   Style="{StaticResource MutedTextStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Background="{StaticResource StageChipBrush}" Padding="10,3" Margin="0,10,0,0"
                                                        HorizontalAlignment="Center" BorderBrush="{StaticResource CautionBorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding StageCompositeFreshnessText}" FontWeight="Medium"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource CautionBrush}"
                                                               AutomationProperties.LiveSetting="Polite"
                                                               AutomationProperties.Name="非ライブ側 鮮度バッジ 経過秒" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="合成対象外（1台構成）"
                                                       FontSize="{StaticResource FontSizeReading}" FontWeight="Medium"
                                                       Foreground="{StaticResource TextStageBrush}"
                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsSingleCameraMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>

                                        <!-- ==================== 設置ガイドオーバーレイ ==================== -->
                                        <!-- 方眼グリッド（issue #32）: ステージ表示領域を列数・行数でちょうど等分する。 -->
                                        <controls:GridLinesOverlay Columns="{Binding GridColumns}" Rows="{Binding GridRows}"
                                                                   LineBrush="{StaticResource OverlayGridLineBrush}"
                                                                   Visibility="{Binding IsGridOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   AutomationProperties.Name="設置ガイドオーバーレイ 方眼グリッド" />

                                        <!-- トンボ（issue #32）: 四隅の合わせマーク。角を挟む2辺の短い罫で示す。 -->
                                        <Grid IsHitTestVisible="False" Margin="8"
                                              Visibility="{Binding IsTombOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="設置ガイド トンボ 四隅の合わせマーク">
                                            <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    BorderBrush="{StaticResource OverlayMarkBrush}" BorderThickness="1,1,0,0" />
                                            <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    BorderBrush="{StaticResource OverlayMarkBrush}" BorderThickness="0,1,1,0" />
                                            <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    BorderBrush="{StaticResource OverlayMarkBrush}" BorderThickness="1,0,0,1" />
                                            <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    BorderBrush="{StaticResource OverlayMarkBrush}" BorderThickness="0,0,1,1" />
                                        </Grid>

                                        <!-- 安全マージン（issue #32） -->
                                        <Grid IsHitTestVisible="False"
                                              Visibility="{Binding IsSafeMarginOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="設置ガイド 安全マージン枠 SAFE MARGIN">
                                            <Rectangle Margin="26" Stroke="{StaticResource OverlaySafeMarginBrush}" StrokeThickness="1"
                                                       StrokeDashArray="4 4" />
                                            <TextBlock Text="安全マージン" Margin="30" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource OverlaySafeMarginTextBrush}" />
                                        </Grid>

                                        <!-- 共通ターゲット□: ドラッグで粗く移動（issue #30）。ステージ表示エリア全体を
                                             覆う透明ハンドルがドラッグを受け、正規化座標(0..1)でVMのTargetX/TargetYを更新する。
                                             処理中プレースホルダ時は非表示・ドラッグ無効。 -->
                                        <Border Background="Transparent"
                                                Visibility="{Binding IsTargetOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                MouseLeftButtonDown="StageDragHandle_MouseLeftButtonDown"
                                                MouseMove="TargetDragHandle_MouseMove"
                                                MouseLeftButtonUp="TargetDragHandle_MouseLeftButtonUp"
                                                MouseLeave="StageHandle_MouseLeave"
                                                AutomationProperties.Name="ステージ ドラッグで共通ターゲット□を粗く移動" />

                                        <Grid Width="92" Height="92" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              IsHitTestVisible="False"
                                              Visibility="{Binding IsTargetOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="共通ターゲット□ 現在位置">
                                            <Grid.Margin>
                                                <MultiBinding Converter="{StaticResource FractionToMarginConverter}" ConverterParameter="92">
                                                    <Binding Path="TargetX" />
                                                    <Binding Path="TargetY" />
                                                    <Binding ElementName="StageDisplayArea" Path="ActualWidth" />
                                                    <Binding ElementName="StageDisplayArea" Path="ActualHeight" />
                                                </MultiBinding>
                                            </Grid.Margin>
                                            <Grid.Resources>
                                                <!-- ライブ側は明るい緑、非ライブ側（静止画）は無彩色。AFできる側がどちらかを色で示す。 -->
                                                <Style x:Key="ReticleCornerStyle" TargetType="Border">
                                                    <Setter Property="Width" Value="18" />
                                                    <Setter Property="Height" Value="18" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTargetOnLiveSide}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ReticleIdleBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Resources>
                                            <Border Style="{StaticResource ReticleCornerStyle}" BorderThickness="1.5,1.5,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Border Style="{StaticResource ReticleCornerStyle}" BorderThickness="0,1.5,1.5,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <Border Style="{StaticResource ReticleCornerStyle}" BorderThickness="1.5,0,0,1.5"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                            <Border Style="{StaticResource ReticleCornerStyle}" BorderThickness="0,0,1.5,1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            <Rectangle Width="9" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Fill="{StaticResource AccentBrightBrush}" />
                                            <Rectangle Width="1" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Fill="{StaticResource AccentBrightBrush}" />
                                        </Grid>

                                        <!-- 拡大エリア（ルーペ）: ステージ上に重ねる。撮影対象から目を離さずにピントを見る。
                                             ここでのドラッグはターゲット□の細かい移動になる（issue #30）。 -->
                                        <Border x:Name="LoupePanel" Width="236" Height="236"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{StaticResource StageBrush}"
                                                BorderBrush="{StaticResource AccentBrightBrush}" BorderThickness="1"
                                                Effect="{StaticResource LoupeShadow}"
                                                Visibility="{Binding IsLoupeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="拡大エリア ルーペ ポインタ位置の等倍クロップ表示">
                                            <Grid x:Name="LoupeDisplayArea" ClipToBounds="True"
                                                  AutomationProperties.Name="拡大エリア 等倍クロップ表示領域">
                                                <Border Background="{StaticResource StageHatchBrush}"
                                                        Visibility="{Binding IsLoupePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Image Source="{Binding LoupeImage}" Stretch="UniformToFill"
                                                       Visibility="{Binding IsLoupeImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.Name="拡大エリア Simulated疑似LVフレーム 等倍クロップ" />
                                                <Image Source="{Binding LoupePeakingOverlay}" Stretch="UniformToFill" IsHitTestVisible="False"
                                                       Visibility="{Binding IsLoupePeakingOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       AutomationProperties.Name="拡大エリア フォーカスピーキング エッジ強調オーバーレイ preview専用" />
                                                <TextBlock Text="{Binding LoupePlaceholderText}" TextAlignment="Center"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Visibility="{Binding IsLoupePlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           AutomationProperties.Name="拡大エリア フレーム未取得プレースホルダ" />

                                                <Border Background="Transparent"
                                                        MouseLeftButtonDown="LoupeDragHandle_MouseLeftButtonDown"
                                                        MouseMove="TargetDragHandle_MouseMove"
                                                        MouseLeftButtonUp="TargetDragHandle_MouseLeftButtonUp"
                                                        AutomationProperties.Name="拡大エリア ドラッグで共通ターゲット□を細かく移動" />

                                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        BorderBrush="{StaticResource AccentBrightBrush}" BorderThickness="1"
                                                        Background="Transparent" IsHitTestVisible="False"
                                                        Visibility="{Binding IsLoupeMarkerVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.Name="拡大エリア内 共通ターゲット□ 枠線">
                                                    <Border.Margin>
                                                        <MultiBinding Converter="{StaticResource FractionToMarginConverter}" ConverterParameter="18">
                                                            <Binding Path="LoupeMarkerRelativeX" />
                                                            <Binding Path="LoupeMarkerRelativeY" />
                                                            <Binding ElementName="LoupeDisplayArea" Path="ActualWidth" />
                                                            <Binding ElementName="LoupeDisplayArea" Path="ActualHeight" />
                                                        </MultiBinding>
                                                    </Border.Margin>
                                                </Border>

                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,3"
                                                        Background="{StaticResource StageChipBrush}" IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding LoupeSourceLabelText}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource AccentBrightBrush}"
                                                               AutomationProperties.Name="拡大エリア 表示ソースカメラ" />
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,3"
                                                        Background="{StaticResource StageChipBrush}" IsHitTestVisible="False"
                                                        Visibility="{Binding IsLoupeFreshnessVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding LoupeFreshnessText}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="{StaticResource FontSizeTiny}"
                                                               Foreground="{StaticResource CautionBrush}"
                                                               AutomationProperties.LiveSetting="Polite"
                                                               AutomationProperties.Name="拡大エリア 鮮度バッジ 非ライブ側静止画" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        </Grid>

                                        <Border Background="{StaticResource StageBrush}" Panel.ZIndex="1"
                                                Visibility="{Binding IsHardwareDualStagePendingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="実機2台 主画面プレビュー無効 機体照合で確認">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620" Margin="28">
                                                <TextBlock Text="実機Live Viewは機体照合画面で確認"
                                                           TextAlignment="Center" FontWeight="Bold"
                                                           FontSize="{StaticResource FontSizeSection}"
                                                           Foreground="{StaticResource AccentBrightBrush}" />
                                                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Text="主画面には模擬画像を表示しません。CAM-A / CAM-Bの目視割当では、機体照合画面で候補を1台ずつ確認してください。" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource StageBrush}" Panel.ZIndex="1"
                                                Visibility="{Binding ShowCaptureRecoveryOnlyInstruction, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="撮影回収専用モードの検証範囲">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620" Margin="28">
                                                <TextBlock Text="実機2台の撮影・原画像回収のみ"
                                                           TextAlignment="Center" FontWeight="Bold"
                                                           FontSize="{StaticResource FontSizeSection}"
                                                           Foreground="{StaticResource AccentBrightBrush}" />
                                                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Text="このメイン画面には実機Live Viewを表示しません。CAM-A / CAM-Bの目視割当は、機体照合画面で1台ずつ確認します。" />
                                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                                           Foreground="{StaticResource CautionBrush}"
                                                           Text="合成・A0品質判定・実シャッター同期保証は本試験の対象外です。確認対象は、撮影後に検証して固定ローカルへ保持した原画像2枚です。" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 通知はステージ上端に出して、操作した直後の視線の先で気づけるようにする。 -->
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                                                Padding="14,6" Panel.ZIndex="4" IsHitTestVisible="False"
                                                BorderThickness="1" Effect="{StaticResource NoticeShadow}"
                                                Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="操作結果の通知">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource CautionNoticeBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CautionBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoticeKind}" Value="ok">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding NoticeText}" FontWeight="Medium"
                                                       FontSize="{StaticResource FontSizeBase}"
                                                       Foreground="{StaticResource AccentOnStrongBrush}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </Border>

                                        <!-- 撮影・合成の進行中はステージ全面を覆う。ここで手を出せる操作は無い、と示すため。 -->
                                        <Grid Background="{StaticResource StageScrimBrush}" Panel.ZIndex="3"
                                              Visibility="{Binding IsActionZoneProcessing, Converter={StaticResource BoolToVisibilityConverter}}"
                                              AutomationProperties.Name="撮影進行オーバーレイ ライブ表示は停止中">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StageProcessingPlaceholderText}" TextAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           FontSize="{StaticResource FontSizeLabel}"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           AutomationProperties.Name="ステージ 撮影シーケンス実行中プレースホルダ" />
                                                <ItemsControl ItemsSource="{Binding ProgressSteps}" Margin="0,18,0,0"
                                                              AutomationProperties.Name="撮影の進行状況 ライブ表示停止からCAM-A撮影CAM-A原画像の確認CAM-B撮影CAM-B原画像の確認合成までの現在位置">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- 色は段の状態キーからテーマのトークンへ解決する。
                                                                 未着手は沈め、進行中だけを明るくして現在位置を1つに絞る。 -->
                                                            <StackPanel Width="148" Margin="3,0">
                                                                <StackPanel.Resources>
                                                                    <Style x:Key="StepBarStyle" TargetType="Border">
                                                                        <Setter Property="Height" Value="4" />
                                                                        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="completed">
                                                                                <Setter Property="Background" Value="{StaticResource AccentDotBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="current">
                                                                                <Setter Property="Background" Value="{StaticResource AccentBrightBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="failure">
                                                                                <Setter Property="Background" Value="{StaticResource BlockerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                    <Style x:Key="StepTextStyle" TargetType="TextBlock">
                                                                        <Setter Property="TextAlignment" Value="Center" />
                                                                        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="completed">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="current">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentOnStrongBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StateKey}" Value="failure">
                                                                                <Setter Property="Foreground" Value="{StaticResource BlockerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Resources>
                                                                <Border Style="{StaticResource StepBarStyle}" />
                                                                <TextBlock Text="{Binding Label}" Margin="0,6,0,0"
                                                                           FontSize="{StaticResource FontSizeCompact}"
                                                                           Style="{StaticResource StepTextStyle}" />
                                                                <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0"
                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                           Style="{StaticResource StepTextStyle}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding ProgressWatchdogText}" Margin="0,18,0,0" TextAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeBase}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           AutomationProperties.Name="watchdog残り秒 実データ未接続時は180秒契約の静的表示" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 傾き読み値（issue #32）: ステージ下部の常駐行。LV frameからの原稿エッジ検出による
                                     面内回転（ROLL）角と許容範囲チップを示す。ガイドであり合否は判定しない
                                     （docs/OPERATOR_UI_SPEC.md 設置ガイドオーバーレイと傾き読み値 節）。 -->
                                <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False"
                                           Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                                Visibility="{Binding IsTiltReadingVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="傾き読み値 常駐行 ROLL角 許容範囲チップ">
                                        <TextBlock Text="{Binding TiltRollDegreesText}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="{StaticResource FontSizeReading}" FontWeight="Medium"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="傾き読み値 面内回転ROLL角 検出不能時は数値を出さない" />
                                        <TextBlock Text="{Binding TiltToleranceChipText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource MonoTextStyle}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.Name="許容範囲チップ 許容値未設定なら判定を出さない" />
                                        <TextBlock Text="PITCHは対象外" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Style="{StaticResource MonoTextStyle}" />
                                    </StackPanel>

                                    <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap"
                                               Text="傾きの数値は目安表示で、撮影の可否や自動補正には使いません" />

                                    <Button x:Name="TechnicalDetailToggle" DockPanel.Dock="Right" Padding="9,2" MinHeight="20"
                                            Click="ToggleTechnicalDetail_Click" Content="▸ 詳細情報"
                                            AutomationProperties.Name="詳細情報の表示切替" />
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="640"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="ライブ表示は保存対象外 ／ 原画像はPCに保持 ／ 2台のシャッターは完全同期ではありません" />
                                    <TextBlock DockPanel.Dock="Right" Text="Info" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Style="{StaticResource SeverityTagStyle}"
                                               Foreground="{StaticResource InfoBrush}" />
                                </DockPanel>

                                <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False"
                                           Visibility="{Binding ShowCaptureRecoveryOnlyInstruction, Converter={StaticResource BoolToVisibilityConverter}}"
                                           AutomationProperties.Name="撮影回収専用モードの補足">
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="実機Live Viewは機体照合専用 ／ 合成・A0品質判定なし ／ 実シャッター同期未保証" />
                                    <TextBlock DockPanel.Dock="Right" Text="CaptureRecoveryOnly" VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               Foreground="{StaticResource CautionBrush}" />
                                </DockPanel>

                                <TextBlock x:Name="TechnicalDetailRow" Grid.Row="4" Margin="0,8,0,0"
                                           Visibility="Collapsed"
                                           Text="{Binding TechnicalDetail}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           Foreground="{StaticResource TextStageBrush}"
                                           AutomationProperties.Name="詳細情報 error code ログ位置" />
                            </Grid>
                        </Grid>

                        <!-- ==================== 右カラム: フォーカスと撮影 ==================== -->
                        <Border Grid.Column="1" Background="{StaticResource RightColumnBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- ========== フォーカス ========== -->
                                <Border Grid.Row="0" Padding="12,10,12,12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        AutomationProperties.Name="フォーカスパネル AF実行 MFステップ ピーキング 固定状態チップ 撮影系操作">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="フォーカス" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                       Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap">
                                                <Run Text="対象: " /><Run Text="{Binding FocusPanelCameraAlias, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- 実機モード（HardwareDual）では承認までフォーカスパネル全体を無効表示し、
                                             理由を併記する（#35 Option A・fail-closed）。UIとSIMULATEDだけ先行実装。 -->
                                        <Border Margin="0,8,0,0" Padding="10" Background="{StaticResource InfoTintBrush}"
                                                BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1"
                                                Visibility="{Binding IsFocusPanelUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                AutomationProperties.Name="フォーカスパネル 実機モードでは無効表示 fail-closed 理由">
                                            <TextBlock Text="{Binding FocusPanelUnavailableReason}" TextWrapping="Wrap"
                                                       FontSize="{StaticResource FontSizeCompact}"
                                                       Foreground="{StaticResource InfoBrush}" />
                                        </Border>

                                        <StackPanel Visibility="{Binding IsFocusPanelAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                                <Button DockPanel.Dock="Left" Content="AF実行" Command="{Binding AutoFocusCommand}"
                                                        IsEnabled="{Binding CanExecuteAutoFocus}" Padding="14,0" MinHeight="34"
                                                        FontSize="{StaticResource FontSizeSection}" FontWeight="Medium"
                                                        Visibility="{Binding ShowAutoFocusButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.Name="共通ターゲット□の位置でコントラストAFを実行" />
                                                <TextBlock DockPanel.Dock="Left" Text="MF" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" />
                                                <Grid DockPanel.Dock="Right" Height="32">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="40" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="◀◀" Command="{Binding MfCoarseBackwardCommand}"
                                                            IsEnabled="{Binding CanUseFocusPanel}" Padding="0" Margin="0,0,1,0"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            AutomationProperties.Name="MF粗ステップ 後退" />
                                                    <Button Grid.Column="1" Content="◀" Command="{Binding MfFineBackwardCommand}"
                                                            IsEnabled="{Binding CanUseFocusPanel}" Padding="0" Margin="0,0,1,0"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            AutomationProperties.Name="MF微ステップ 後退" />
                                                    <Button Grid.Column="2" Content="▶" Command="{Binding MfFineForwardCommand}"
                                                            IsEnabled="{Binding CanUseFocusPanel}" Padding="0" Margin="0,0,1,0"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            AutomationProperties.Name="MF微ステップ 前進" />
                                                    <Button Grid.Column="3" Content="▶▶" Command="{Binding MfCoarseForwardCommand}"
                                                            IsEnabled="{Binding CanUseFocusPanel}" Padding="0"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            AutomationProperties.Name="MF粗ステップ 前進" />
                                                </Grid>
                                            </DockPanel>

                                            <!-- ピント位置は相対インジケータまで。絶対値の目盛りやスライダーは出さない。 -->
                                            <DockPanel Margin="0,10,0,0">
                                                <TextBlock DockPanel.Dock="Left" Text="ピント位置" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FocusPositionText}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}"
                                                           AutomationProperties.Name="フォーカス状態値 read-only 相対インジケータ 絶対値スライダーではない" />
                                                <Border Height="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Background="{StaticResource BorderBrush}" />
                                            </DockPanel>

                                            <Button Content="{Binding SwitchLiveCameraButtonText}" Command="{Binding SwitchLiveCameraToTargetDomainCommand}"
                                                    Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                                    Visibility="{Binding ShowSwitchLiveCameraButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    AutomationProperties.Name="共通ターゲット□が非ライブ側カメラの担当域 ワンクリックでLive View切替 自動切替はしない" />

                                            <TextBlock Text="{Binding FocusResultText}" Margin="0,8,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       AutomationProperties.Name="AF実行結果 合焦OK NG 実行時刻 使用した□位置" />

                                            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="フォーカスピーキング" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" />
                                                <Button DockPanel.Dock="Right" Content="{Binding PeakingButtonText}" Command="{Binding TogglePeakingCommand}"
                                                        AutomationProperties.Name="フォーカスピーキング LVフレームへのエッジ強調オーバーレイ preview専用 ON OFF切替" />
                                            </DockPanel>

                                            <!-- ピント固定は撮影のゲートにしない。未固定でも撮影はできる（Caution 止まり）。 -->
                                            <Border Margin="0,10,0,0" Padding="10,8" Background="{StaticResource CardBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="ピント固定" VerticalAlignment="Center"
                                                               Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CameraBFocusStatusText}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}"
                                                               AutomationProperties.Name="CAM-B フォーカス固定状態チップ" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CameraAFocusStatusText}"
                                                               VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}"
                                                               AutomationProperties.Name="CAM-A フォーカス固定状態チップ" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ========== 撮影 ========== -->
                                <Grid Grid.Row="1" Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="撮影" Style="{StaticResource SectionTitleStyle}" />

                                    <!-- 設置判定カード -->
                                    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="設置判定" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" />
                                                <Border DockPanel.Dock="Right" Padding="10,0" Height="24"
                                                        Background="{StaticResource AccentTintBrush}"
                                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding SetupStatusText}" VerticalAlignment="Center"
                                                               FontSize="{StaticResource FontSizeBody}" FontWeight="Medium"
                                                               Foreground="{StaticResource AccentBrightBrush}"
                                                               AutomationProperties.LiveSetting="Polite"
                                                               AutomationProperties.Name="設置判定 三状態" />
                                                </Border>
                                            </DockPanel>
                                            <Border Height="1" Margin="0,10" Background="{StaticResource BorderBrush}" />
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="予定する自動補正" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding CorrectionText}" Margin="0,4,0,0"
                                                       FontSize="{StaticResource FontSizeBody}" />
                                            <TextBlock Text="{Binding PhysicalAdjustmentText}" Margin="0,8,0,0"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{StaticResource CautionBrush}"
                                                       AutomationProperties.Name="必要な物理調整" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 運用カメラと保存先 -->
                                    <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding CameraSelectionLabel}" VerticalAlignment="Center"
                                                           Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />
                                                <ListBox DockPanel.Dock="Right" Style="{StaticResource MonoSegmentListStyle}"
                                                         ItemsSource="{Binding CameraAliases}" SelectedItem="{Binding SelectedCamera}"
                                                         IsEnabled="{Binding CanSelectCamera}"
                                                         AutomationProperties.Name="運用対象カメラの選択" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding OperatingModeDescription}" Margin="0,8,0,0"
                                                       FontSize="{StaticResource FontSizeCompact}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="{Binding OutputDirectoryLabel}" Margin="0,10,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="{StaticResource FontSizeCompact}" />
                                            <DockPanel Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="選択…" Margin="8,0,0,0" Padding="12,4"
                                                        Click="ChooseExportDirectory_Click"
                                                        IsEnabled="{Binding CanChangeExportDirectory}"
                                                        Visibility="{Binding IsStandardStageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.Name="操作者が選ぶ保存先フォルダ このPC内のみ フォルダ選択ダイアログを開く" />
                                                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                                        BorderThickness="1" Padding="7,5">
                                                    <TextBlock Text="{Binding OutputDirectory}" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" ToolTip="{Binding OutputDirectory}"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="{StaticResource FontSizeCompact}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               AutomationProperties.Name="{Binding OutputDirectory, StringFormat='現在の保存先 {0}'}" />
                                                </Border>
                                            </DockPanel>

                                            <!-- 保存したファイルの控え。自動保存はしないので、ここが増えていれば
                                                 操作者が保存を押したということ。 -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding HasSavedFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="保存したファイル" VerticalAlignment="Center"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               FontSize="{StaticResource FontSizeCompact}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SavedFileCountText}" VerticalAlignment="Center"
                                                               Style="{StaticResource MonoTextStyle}" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding SavedFiles}" Margin="0,5,0,0"
                                                              AutomationProperties.Name="保存したファイルの一覧 保存操作を行ったときだけ増えます">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,2" Padding="8,4" Background="{StaticResource RightColumnBrush}"
                                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Margin="0,0,8,0"
                                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                                               FontSize="{StaticResource FontSizeSmall}"
                                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap" ToolTip="{Binding Path}"
                                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                                               FontSize="{StaticResource FontSizeCompact}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ========== アクションゾーン ========== -->
                                    <!-- アクションゾーン（issue #33）: 右カラム下部の単一領域。UI状態に応じて
                                         設置判定+撮影ボタン／自動進捗ストリップ／結果パネルを排他的に入替える。
                                         フェーズナビ・ウィザードは採用しない（docs/OPERATOR_UI_SPEC.md アクションゾーン節）。 -->
                                    <!-- 状態によって中身の高さが変わる。あふれた分は畳まず、この枠内でだけ送る。 -->
                                    <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Bottom">
                                    <Border Style="{StaticResource CardStyle}"
                                            AutomationProperties.Name="アクションゾーン 状態駆動 設置判定撮影 自動進捗 結果">
                                        <StackPanel>

                                            <!-- state 1: NotReady/Ready/ReadyWithCorrection（起動時のAwaitingSafetyAck/
                                                 CheckingReadinessもここに含む）: 撮影ボタン2種 -->
                                            <StackPanel Visibility="{Binding IsActionZonePreparing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.Name="アクションゾーン state1 準備中 設置判定と撮影ボタン">
                                                <Border Margin="0,0,0,10" Padding="10" Background="{StaticResource RightColumnBrush}"
                                                        BorderBrush="{StaticResource CautionBrush}" BorderThickness="1"
                                                        Visibility="{Binding ShowCaptureRecoveryOnlyInstruction, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <CheckBox IsChecked="{Binding IsCaptureRecoveryOnlyOperatorApproved}"
                                                              AutomationProperties.Name="{Binding CaptureRecoveryOnlyConfirmationAutomationName}">
                                                        <TextBlock Text="{Binding CaptureRecoveryOnlyConfirmationText}"
                                                                   TextWrapping="Wrap" FontWeight="Medium"
                                                                   Foreground="{StaticResource CautionBrush}" />
                                                    </CheckBox>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="96" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 主ボタン（大）: 現在のフォーカス位置のまま撮影。序列は固定（#31方針どおりAF付きを主にしない） -->
                                                    <Button Grid.Column="0" Style="{StaticResource PrimaryActionButtonStyle}"
                                                            Command="{Binding CaptureCommand}" IsEnabled="{Binding CanCapture}"
                                                            AutomationProperties.Name="{Binding CaptureButtonAutomationName}">
                                                        <TextBlock Text="{Binding CaptureButtonText}" TextAlignment="Center" TextWrapping="Wrap"
                                                                   FontSize="{StaticResource FontSizePrimaryAction}" FontWeight="Bold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                    <!-- 従ボタン（小）: 撮影+AF。各カメラの撮影直前へAF段を挿入し、NGならシャッターへ進まずfail-closed停止する -->
                                                    <Button Grid.Column="2" Command="{Binding CaptureWithAutoFocusCommand}"
                                                            IsEnabled="{Binding CanCaptureWithAutoFocus}" Padding="4"
                                                            AutomationProperties.Name="従ボタン 撮影+AF 各カメラの撮影直前にAFを実行してから撮影 AF失敗時はfail-closedで停止し自動リトライしない">
                                                        <StackPanel>
                                                            <TextBlock Text="撮影 + AF" TextAlignment="Center"
                                                                       FontSize="{StaticResource FontSizeLabel}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <TextBlock Text="AF→撮影" TextAlignment="Center" Margin="0,2,0,0"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="{StaticResource FontSizeTiny}"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="A→Bの順に撮影し、完了後に合成へ進みます。" Margin="0,8,0,0"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Visibility="{Binding ShowAutomaticStitchInstruction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding CaptureRecoveryOnlyInstructionText}"
                                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                                           Foreground="{StaticResource CautionBrush}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Visibility="{Binding ShowCaptureRecoveryOnlyInstruction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding CaptureDisabledReason}" Margin="0,6,0,0"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource CautionBrush}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="{Binding CaptureWithAutoFocusUnavailableReason}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource InfoBrush}"
                                                           Visibility="{Binding IsCaptureWithAutoFocusUnavailableReasonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           AutomationProperties.Name="撮影+AF 実機モードでは実行不可 理由" />
                                            </StackPanel>

                                            <!-- state 2: Capturing/Stitching。進捗本体はステージ側オーバーレイへ出す。 -->
                                            <StackPanel Visibility="{Binding IsActionZoneProcessing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.Name="アクションゾーン state2 自動進捗ストリップ">
                                                <TextBlock Text="{Binding OverallStateText}" FontWeight="Medium"
                                                           FontSize="{StaticResource FontSizeLabel}"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           AutomationProperties.Name="自動進捗 現在の全体状態" />
                                                <TextBlock Text="この間は他の操作はできません。" Margin="0,6,0,0"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           FontSize="{StaticResource FontSizeCompact}" />
                                            </StackPanel>

                                            <!-- state 3: Review/FailedPartial/Degraded: 結果パネル -->
                                            <StackPanel Visibility="{Binding IsActionZoneReview, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        AutomationProperties.Name="アクションゾーン state3 結果パネル">
                                                <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           AutomationProperties.LiveSetting="Assertive"
                                                           AutomationProperties.Name="撮影と失敗の共通結果" />
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Grid.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
                                                            <Setter Property="Margin" Value="0,0,0,3" />
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        </Style>
                                                    </Grid.Resources>
                                                    <TextBlock Grid.Row="0" Text="撮影ID" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastTransactionId}" Margin="10,0,0,3"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Text="撮影" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureResult}" Margin="10,0,0,3"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="2" Text="保持原画像" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RetainedOriginals}" Margin="10,0,0,3"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="3" Text="{Binding ProcessingResultLabel}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StitchResult}" Margin="10,0,0,3"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="4" Text="保存" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExportResult}" Margin="10,0,0,3"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Row="5" Text="出力先" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastExportPath}" Margin="10,0,0,3"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Grid>

                                                <Button Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,10,0,0" MinHeight="42"
                                                        FontSize="{StaticResource FontSizeSection}"
                                                        Content="このPCのフォルダへ保存" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"
                                                        AutomationProperties.Name="確認済みの単体原画像または合成結果をこのPCのフォルダへ明示保存" />
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="撮影済み画像で再合成" Command="{Binding RestitchCommand}"
                                                            IsEnabled="{Binding CanRestitch}"
                                                            FontSize="{StaticResource FontSizeBody}" />
                                                    <Button Grid.Column="2" Content="新しい撮影を準備" Command="{Binding PrepareNewCaptureCommand}"
                                                            IsEnabled="{Binding CanPrepareNewCapture}"
                                                            FontSize="{StaticResource FontSizeBody}"
                                                            AutomationProperties.Name="read-only readiness再検査" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- 警告3段: 色だけに頼らず Blocker / Caution / Info の文字を必ず併記する。 -->
                                            <Border Height="1" Margin="0,10" Background="{StaticResource BorderBrush}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Blocker" Style="{StaticResource SeverityTagStyle}"
                                                           Foreground="{StaticResource BlockerBrush}" Margin="0,0,8,4" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BlockerText}" Margin="0,0,0,4"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource BlockerBrush}"
                                                           AutomationProperties.LiveSetting="Assertive" />
                                                <TextBlock Grid.Row="1" Text="Caution" Style="{StaticResource SeverityTagStyle}"
                                                           Foreground="{StaticResource CautionBrush}" Margin="0,0,8,4" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CautionText}" Margin="0,0,0,4"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource CautionBrush}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Grid.Row="2" Text="Info" Style="{StaticResource SeverityTagStyle}"
                                                           Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InfoText}"
                                                           FontSize="{StaticResource FontSizeCompact}"
                                                           Foreground="{StaticResource InfoBrush}" />
                                            </Grid>
                                            <TextBlock Margin="0,8,0,0" FontSize="{StaticResource FontSizeCompact}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="NO AUTO RETRY ／ 撮影失敗（再開不可）は再開・再試行しません。自動再試行回数は0回固定です。"
                                                       AutomationProperties.Name="No automatic retry warning" />
                                        </StackPanel>
                                    </Border>
                                    </ScrollViewer>

                                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource MonoTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="CAM-A / CAM-B: Nikon D810 ／ 7360×4912 ／ JPEG Fine L" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 設置・校正（保守画面・移設のみ・中身は再設計しない）。ツール(T)メニューからのみ
                         到達し、ダッシュボードへは「戻る」ボタン（ShowDashboardCommand・既存の
                         CanOpenMaintenance連動）で戻る。 -->
                    <ScrollViewer Background="{StaticResource LeftColumnBrush}"
                                  Visibility="{Binding SelectedPage, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Setup}"
                                  VerticalScrollBarVisibility="Auto" AutomationProperties.Name="設置・校正 保守画面">
                        <StackPanel Margin="18" MaxWidth="960" HorizontalAlignment="Left">
                            <Button Content="← 撮影ダッシュボードへ戻る" Command="{Binding ShowDashboardCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    AutomationProperties.Name="保守画面から撮影ダッシュボードへ戻る" />
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="設置・校正（模擬動作）" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="承認済みプロファイルの閾値を使い、補正不要・自動補正範囲内・物理調整必要を検証します。プロファイルを自動更新しません。"
                                               Margin="0,6,0,12" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text="表示シナリオ" FontWeight="Medium" />
                                    <ComboBox ItemsSource="{Binding ReadinessDemoOptions}" SelectedItem="{Binding SelectedReadinessDemo}"
                                              Width="260" HorizontalAlignment="Left" Margin="0,6,0,12" />
                                    <Border Padding="14" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SetupStatusText}" FontSize="{StaticResource FontSizeReading}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding CorrectionText}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding PhysicalAdjustmentText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Visibility="{Binding IsSimulatedFrameSourceAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="模擬ライブ表示のパターン（開発・検証用）" FontWeight="Medium" Margin="0,16,0,0" />
                                        <TextBlock Text="正対・傾き（エッジ検出の確認用）・ボケ→合焦の遷移（ピーキングの確認用）を切り替えられます。ステージの CAM-A / CAM-B ライブ表示・合成プレビューへ即時反映されます。"
                                                   Margin="0,4,0,6" Style="{StaticResource MutedTextStyle}" MaxWidth="640" />
                                        <ComboBox ItemsSource="{Binding SimulatedFramePatternOptions}" SelectedItem="{Binding SelectedSimulatedFramePattern}"
                                                  IsEnabled="{Binding CanChangeSimulatedFramePattern}"
                                                  Width="260" HorizontalAlignment="Left" Margin="0,0,0,12"
                                                  AutomationProperties.Name="疑似LVフレームソース パターン切替 開発検証用" />
                                    </StackPanel>
                                    <TextBlock Text="傾きの許容値（表示のみ・撮影可否には使いません）" FontWeight="Medium" Margin="0,10,0,0" />
                                    <TextBox Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"
                                             Text="{Binding TiltToleranceInputText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="許容範囲チップ 許容値入力 簡素な入力 未設定なら既定値を作らない" />
                                    <Button Content="校正を開始（未実装・human gate待ち）" IsEnabled="False" Margin="0,14,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- カメラ設定（保守画面・read-only・移設のみ）。カメラ(C)メニューからのみ到達する。 -->
                    <ScrollViewer Background="{StaticResource LeftColumnBrush}"
                                  Visibility="{Binding SelectedPage, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=CameraSettings}"
                                  VerticalScrollBarVisibility="Auto" AutomationProperties.Name="カメラ設定 保守画面">
                        <StackPanel Margin="18" MaxWidth="960" HorizontalAlignment="Left">
                            <Button Content="← 撮影ダッシュボードへ戻る" Command="{Binding ShowDashboardCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    AutomationProperties.Name="保守画面から撮影ダッシュボードへ戻る" />
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="カメラ設定（read-only）" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="書き込みの契約が実機の証拠で承認されるまで、設定変更は実装しません。FX ／ JPEG Fine L ／ 固定露出 ／ 固定フォーカス ／ 固定WB ／ Auto ISOなし ／ VRなし を確認対象とします。"
                                               Margin="0,8,0,12" Style="{StaticResource MutedTextStyle}" />
                                    <DataGrid ItemsSource="{Binding CameraSettingRows}" IsReadOnly="True" AutoGenerateColumns="False"
                                              HeadersVisibility="Column" Height="230" CanUserAddRows="False" CanUserDeleteRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="設定" Binding="{Binding Setting}" Width="120" />
                                            <DataGridTextColumn Header="要求profile" Binding="{Binding RequiredProfile}" Width="2*" />
                                            <DataGridTextColumn Header="CAM-A" Binding="{Binding CameraA}" Width="*" />
                                            <DataGridTextColumn Header="CAM-B" Binding="{Binding CameraB}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="設定を書き込む（禁止）" IsEnabled="False" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 保存・診断（保守画面・移設のみ）。ツール(T)メニューからのみ到達する。 -->
                    <ScrollViewer Background="{StaticResource LeftColumnBrush}"
                                  Visibility="{Binding SelectedPage, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Diagnostics}"
                                  VerticalScrollBarVisibility="Auto" AutomationProperties.Name="保存・診断 保守画面">
                        <StackPanel Margin="18" MaxWidth="960" HorizontalAlignment="Left">
                            <Button Content="← 撮影ダッシュボードへ戻る" Command="{Binding ShowDashboardCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    AutomationProperties.Name="保守画面から撮影ダッシュボードへ戻る" />
                            <Border Style="{StaticResource CardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="保存・診断（模擬動作）" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="失敗箇所の表示を確認します。撮影開始の条件を満たす場合だけ実行でき、カード削除・フォーマット・ベンダー操作 0x9207 は呼びません。"
                                               Margin="0,6,0,12" Style="{StaticResource MutedTextStyle}" />
                                    <DockPanel LastChildFill="False">
                                        <ComboBox DockPanel.Dock="Left" Width="250" ItemsSource="{Binding DiagnosticScenarios}"
                                                  SelectedItem="{Binding SelectedDiagnosticScenario}" Margin="0,0,8,0" />
                                        <Button DockPanel.Dock="Left" Content="診断シナリオを実行" Command="{Binding DiagnosticCommand}"
                                                IsEnabled="{Binding CanCapture}" />
                                    </DockPanel>
                                    <TextBlock Text="常時禁止: 同じ撮影IDの再開・再試行 ／ 過去のCAM-Bとの自動ペア ／ SDK・WPDの重複接続 ／ 2台同時のライブ表示 ／ ライブ表示を原画像として使うこと ／ 一括削除 ／ フォーマット ／ ベンダー操作 0x9207 ／ PC側の原画像確認前の削除 ／ 撮影中の設定変更 ／ 原画像の上書き・自動削除"
                                               Margin="0,12,0,0" FontWeight="Medium" />
                                    <TextBlock Text="{Binding TechnicalDetail}" Margin="0,12,0,0" Padding="12"
                                               Background="{StaticResource CardBrush}" Style="{StaticResource MonoTextStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="作成済みの撮影ID数（連打防止の確認用）" FontWeight="Medium" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding TransactionStartCount}" FontSize="{StaticResource FontSizeDialogTitle}"
                                               FontFamily="{StaticResource MonoFontFamily}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================ ステータスバー ============================ -->
                <Border Grid.Row="3" Background="{StaticResource BarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="False" Margin="14,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}"
                                   FontSize="{StaticResource FontSizeCompact}">
                            <Run Text="撮影ID " /><Run Text="{Binding LastTransactionId, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Left" Text="|" Margin="14,0" VerticalAlignment="Center"
                                   Style="{StaticResource MonoTextStyle}" Foreground="{StaticResource BorderStrongBrush}" />
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}"
                                   FontSize="{StaticResource FontSizeCompact}" TextTrimming="CharacterEllipsis" MaxWidth="360">
                            <Run Text="原画像 " /><Run Text="{Binding RetainedOriginals, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Left" Text="|" Margin="14,0" VerticalAlignment="Center"
                                   Style="{StaticResource MonoTextStyle}" Foreground="{StaticResource BorderStrongBrush}" />
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}"
                                   FontSize="{StaticResource FontSizeCompact}" TextTrimming="CharacterEllipsis" MaxWidth="420">
                            <Run Text="合成 " /><Run Text="{Binding StitchResult, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Style="{StaticResource MonoTextStyle}" FontSize="{StaticResource FontSizeCompact}"
                                   Foreground="{StaticResource AccentBrightBrush}"
                                   Text="このアプリだけがカメラを使用中" />
                    </DockPanel>
                </Border>

                <!-- ========================== 機体照合（binding） ==========================
                     ADR-0025。2台のうち「いま表示している1台」を CAM-A / CAM-B のどちらかへ
                     操作者が明示的に割り当てる。2台を同時に表示しないのは、並べて見比べる操作
                     こそがこの画面の防ごうとしている取り違えそのものだから。
                     割当が Ready になるまで撮影は開始できない（Single へのフォールバックも無い）。 -->
                <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="9"
                      Background="{StaticResource ModalScrimBrush}"
                      Visibility="{Binding DualBinding.IsOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      AutomationProperties.Name="機体照合（CAM-A / CAM-B の割当）">
                    <Border Width="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                            Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" Effect="{StaticResource DropdownShadow}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding DualBinding.HeadlineText}" FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeDialogTitle}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Border DockPanel.Dock="Right" Padding="8,2" VerticalAlignment="Center"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource CautionBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DualBinding.HeadlineKind}" Value="Block">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BlockerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DualBinding.HeadlineKind}" Value="Info">
                                                    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- 色だけに頼らず必ず文字で状態を併記する（色覚・読み上げ両対応） -->
                                    <TextBlock Text="{Binding DualBinding.HeadlineKind}"
                                               Style="{StaticResource MonoTextStyle}"
                                               AutomationProperties.Name="機体照合の状態区分" />
                                </Border>
                            </DockPanel>

                            <TextBlock Margin="0,14,0,0" Style="{StaticResource MutedTextStyle}"
                                       FontSize="{StaticResource FontSizeLabel}" LineHeight="20" TextWrapping="Wrap"
                                       Text="{Binding DualBinding.ResidualRiskText, Mode=OneTime}"
                                       AutomationProperties.Name="機体照合の残留リスク" />

                            <Border Margin="0,14,0,0" Padding="10" BorderThickness="1"
                                    BorderBrush="{StaticResource BlockerBrush}" Background="{StaticResource CardBrush}"
                                    Visibility="{Binding DualBinding.IsInvalidationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding DualBinding.InvalidationText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource BlockerBrush}"
                                           AutomationProperties.LiveSetting="Assertive"
                                           AutomationProperties.Name="再bindingが必要な理由" />
                            </Border>

                            <!-- 候補の選択。ListBox にしているのは矢印キーだけで候補を移動でき、
                                 読み上げにも「候補1 未割当 表示中」がそのまま渡るため。 -->
                            <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding DualBinding.Candidates}"
                                          Visibility="{Binding DualBinding.IsCandidateStageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                          AutomationProperties.Name="binding 候補一覧">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="4" MinHeight="52" HorizontalContentAlignment="Left" Padding="12,6"
                                                Command="{Binding DataContext.DualBinding.ShowCandidateCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding AccessibleName}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                           FontSize="{StaticResource FontSizeSection}" />
                                                <TextBlock Text="{Binding AssignmentText}" Style="{StaticResource MonoTextStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ライブ表示は常に1台ぶんだけ。取得できたフレームは表示のためだけに保持し、保存しない。 -->
                            <Border Margin="0,12,0,0" Height="240" Background="{StaticResource StageBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    Visibility="{Binding DualBinding.IsCandidateStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Image Source="{Binding DualBinding.PreviewImage}" Stretch="Uniform" Margin="6"
                                           Visibility="{Binding DualBinding.IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                           AutomationProperties.Name="表示中の候補のライブ表示" />
                                    <TextBlock Text="{Binding DualBinding.PreviewPlaceholderText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}"
                                               Visibility="{Binding DualBinding.IsPreviewPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                               AutomationProperties.Name="ライブ表示の代替説明" />
                                    <TextBlock Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left"
                                               Style="{StaticResource MonoTextStyle}"
                                               Text="{Binding DualBinding.SelectedCandidateName, StringFormat=表示中: {0}}"
                                               AutomationProperties.Name="表示中の候補" />
                                </Grid>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,12,0,0"
                                         Visibility="{Binding DualBinding.IsCandidateStageVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Margin="0,0,4,0" MinHeight="46" Content="表示中を CAM-A にする"
                                        Command="{Binding DualBinding.AssignCameraACommand}"
                                        AutomationProperties.Name="表示中の候補を CAM-A に割り当てる" />
                                <Button Margin="4,0,0,0" MinHeight="46" Content="表示中を CAM-B にする"
                                        Command="{Binding DualBinding.AssignCameraBCommand}"
                                        AutomationProperties.Name="表示中の候補を CAM-B に割り当てる" />
                            </UniformGrid>

                            <!-- 確定前の確認。ここを飛ばすと「押したら終わっていた」になる。 -->
                            <Border Margin="0,14,0,0" Padding="12" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    Visibility="{Binding DualBinding.IsSummaryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="この割当で確定します" FontWeight="Bold"
                                               FontSize="{StaticResource FontSizeSection}" />
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DualBinding.SummaryLines}"
                                                  AutomationProperties.Name="確定する割当">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource MonoTextStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,14,0,0" MinHeight="46"
                                    Content="機体照合を開始"
                                    Command="{Binding DualBinding.BeginBindingCommand}"
                                    AutomationProperties.Name="機体照合を開始する" />
                            <Button Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,10,0,0" MinHeight="46"
                                    Content="この割当で確定する"
                                    Command="{Binding DualBinding.CompleteBindingCommand}"
                                    Visibility="{Binding DualBinding.IsSummaryVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                    AutomationProperties.Name="この割当で機体照合を確定する" />

                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="{Binding DualBinding.NoticeText}"
                                       Visibility="{Binding DualBinding.IsNoticeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="機体照合の通知">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DualBinding.NoticeKind}" Value="block">
                                                <Setter Property="Foreground" Value="{StaticResource BlockerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DualBinding.NoticeKind}" Value="caution">
                                                <Setter Property="Foreground" Value="{StaticResource CautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ 起動時の同意 ============================ -->
                <!-- 同意するまで撮影・設定・保存の全操作を無効にする。同意はこのセッション限りで、
                     終了時に失効する（永続化しない）。 -->
                <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="10"
                      Background="{StaticResource ModalScrimBrush}"
                      Visibility="{Binding IsConsentOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      AutomationProperties.Name="起動セッションの排他同意">
                    <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                            Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" Effect="{StaticResource DropdownShadow}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="起動セッションの排他同意" FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeDialogTitle}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SafetyAckText}" VerticalAlignment="Bottom"
                                           Style="{StaticResource MonoTextStyle}"
                                           Foreground="{StaticResource CautionBrush}" />
                            </DockPanel>
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource MutedTextStyle}"
                                       FontSize="{StaticResource FontSizeLabel}" LineHeight="20"
                                       Text="同意はこのセッションのみ有効で、終了時に失効します。同意するまで撮影・設定・保存の全操作は無効です。" />

                            <Border Margin="0,16,0,0" Padding="12" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                <CheckBox IsChecked="{Binding IsPhysicalShutterAckAccepted, Mode=TwoWay}"
                                          Content="撮影中に物理シャッターを操作しません"
                                          FontSize="{StaticResource FontSizeSection}"
                                          AutomationProperties.Name="物理シャッターを操作しないことに同意" />
                            </Border>
                            <Border Margin="0,10,0,0" Padding="12" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                <CheckBox IsChecked="{Binding IsExclusiveUseAckAccepted, Mode=TwoWay}"
                                          Content="他のカメラ撮影ソフトでカメラを占有しません"
                                          FontSize="{StaticResource FontSizeSection}"
                                          AutomationProperties.Name="他のカメラアプリでカメラを占有しないことに同意" />
                            </Border>

                            <Button Style="{StaticResource PrimaryActionButtonStyle}" Margin="0,18,0,0" MinHeight="46"
                                    Content="同意して開始" Command="{Binding AcceptSafetyCommand}"
                                    AutomationProperties.Name="物理シャッターと他アプリを使わないことに同意" />
                            <Button Margin="0,10,0,0" Content="同意しない（操作を行わない）" Command="{Binding DeclineSafetyCommand}"
                                    HorizontalAlignment="Center" FontSize="{StaticResource FontSizeBody}"
                                    AutomationProperties.Name="排他使用へ同意しない" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

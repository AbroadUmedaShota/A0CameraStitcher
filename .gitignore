# Build outputs
bin/
obj/
out/
build/
build-*/
.vs/
.idea/
*.user
*.suo

# Native dependencies and caches
.tools/
vcpkg_installed/
CMakeFiles/
CMakeCache.txt

# Camera SDKs and licensed binaries
vendor/nikon-sdk/
**/nikon-sdk/
*.dll
*.lib
*.pdb

# Captures and generated images
captures/
samples/private/
artifacts/
*.nef
*.nrw
*.tif
*.tiff
*.jpg
*.jpeg
*.png

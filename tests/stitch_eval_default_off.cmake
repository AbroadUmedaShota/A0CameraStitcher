cmake_minimum_required(VERSION 3.24)
foreach(required SOURCE_ROOT TEST_ROOT TEST_GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
# Each run gets a new cache, so an explicit option or an earlier configure
# cannot conceal a change to the default. This directory is test-owned.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(build_dir "${TEST_ROOT}/${nonce}")
file(MAKE_DIRECTORY "${build_dir}/.cmake/api/v1/query")
file(WRITE "${build_dir}/.cmake/api/v1/query/codemodel-v2" "")
set(platform_args "")
if(DEFINED TEST_PLATFORM AND NOT "${TEST_PLATFORM}" STREQUAL "")
    list(APPEND platform_args -A "${TEST_PLATFORM}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}" -B "${build_dir}"
    -G "${TEST_GENERATOR}" ${platform_args} -DBUILD_TESTING=OFF
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "default configure failed (${result}): ${output}${errors}")
endif()
file(STRINGS "${build_dir}/CMakeCache.txt" default_value REGEX "^A0_BUILD_STITCH_EVAL:BOOL=")
if(NOT "${default_value}" STREQUAL "A0_BUILD_STITCH_EVAL:BOOL=OFF")
    message(FATAL_ERROR "evaluation option must default OFF: ${default_value}")
endif()
file(GLOB codemodels "${build_dir}/.cmake/api/v1/reply/codemodel-v2-*.json")
list(LENGTH codemodels model_count)
if(NOT model_count EQUAL 1)
    message(FATAL_ERROR "expected a fresh codemodel reply")
endif()
list(GET codemodels 0 codemodel_path)
file(READ "${codemodel_path}" model)
string(JSON config_count LENGTH "${model}" configurations)
math(EXPR config_last "${config_count} - 1")
set(product_control FALSE)
foreach(config RANGE 0 ${config_last})
    string(JSON target_count LENGTH "${model}" configurations ${config} targets)
    math(EXPR target_last "${target_count} - 1")
    foreach(target RANGE 0 ${target_last})
        string(JSON name GET "${model}" configurations ${config} targets ${target} name)
        if(name STREQUAL "A0CameraStitcher.StitchEval")
            message(FATAL_ERROR "default build exposes the evaluation executable")
        endif()
        if(name STREQUAL "A0CameraStitcher.M2Adapter")
            set(product_control TRUE)
        endif()
    endforeach()
endforeach()
if(NOT product_control)
    message(FATAL_ERROR "positive control: product executable must be present")
endif()
message(STATUS "Default OFF verified: no evaluation target in any configuration; product control present")

# Source contracts of the Live-open capture probe (#426 stage 4, ADR-0044). -DSOURCE_ROOT=<repo root>.
# Reads files only; runs nothing.
#  1. The shutter request (0x90C0) is built in one place and sent through one call: wpd_live_capture_probe.hpp holds
#     exactly one BuildWpdStillRequest(WpdStillOperation::CaptureNoAf) and exactly one .ShutterOnce( call; the window
#     and Camera glue (wpd_dual_preview_live_probe*.hpp) and the main file name neither, nor the literal 0x90c0.
#  2. The probe button is clicked by a synthetic message only inside the camera-free smoke, which uses a synthetic
#     backend. No other line sends kLiveProbeButtonId in a message, and the smoke is the only place that swaps the
#     backend.
#  3. The probe header refuses to compile without the build option (an #error on the macro), and the window and
#     Camera glue are included only under that macro.
if(NOT DEFINED SOURCE_ROOT OR NOT EXISTS "${SOURCE_ROOT}/CMakeLists.txt")
    message(FATAL_ERROR "live capture probe source check: missing SOURCE_ROOT")
endif()
set(experimental "${SOURCE_ROOT}/src/phase0/experimental")
set(include_dir "${SOURCE_ROOT}/src/phase0/include/a0/phase0/experimental")
set(probe_header "${include_dir}/wpd_live_capture_probe.hpp")
set(glue "${experimental}/wpd_dual_preview_live_probe.hpp")
set(window_side "${experimental}/wpd_dual_preview_live_probe_ui.hpp")
set(smoke "${experimental}/wpd_dual_preview_live_probe_smoke.hpp")
set(main_file "${experimental}/wpd_dual_preview_main.cpp")
set(ui_file "${experimental}/wpd_dual_preview_ui.hpp")
foreach(file "${probe_header}" "${glue}" "${window_side}" "${smoke}" "${main_file}" "${ui_file}")
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "live capture probe source check: missing ${file}")
    endif()
endforeach()

# 1. One place builds the shutter, one call sends it.
file(STRINGS "${probe_header}" header_lines)
set(builds 0)
set(calls 0)
foreach(line IN LISTS header_lines)
    if(line MATCHES "BuildWpdStillRequest[(]WpdStillOperation::CaptureNoAf[)]")
        math(EXPR builds "${builds} + 1")
    endif()
    if(line MATCHES "[.]ShutterOnce[(]")
        math(EXPR calls "${calls} + 1")
    endif()
endforeach()
if(NOT builds EQUAL 1)
    message(FATAL_ERROR "live capture probe source check: expected 1 shutter request build in the probe header, found ${builds}")
endif()
if(NOT calls EQUAL 1)
    message(FATAL_ERROR "live capture probe source check: expected 1 .ShutterOnce( call in the probe header, found ${calls}")
endif()
foreach(file "${glue}" "${window_side}" "${smoke}" "${main_file}")
    file(STRINGS "${file}" lines)
    foreach(line IN LISTS lines)
        if(line MATCHES "ShutterOnce[(]" OR line MATCHES "CaptureNoAf")
            message(FATAL_ERROR "live capture probe source check: ${file} names the probe shutter outside the probe header: ${line}")
        endif()
    endforeach()
endforeach()
# The probe's own files do not even spell the opcode (the main file has the existing still lane's own use of it).
foreach(file "${glue}" "${window_side}" "${smoke}")
    file(STRINGS "${file}" lines)
    foreach(line IN LISTS lines)
        if(line MATCHES "0x90[cC]0")
            message(FATAL_ERROR "live capture probe source check: ${file} spells the shutter opcode: ${line}")
        endif()
    endforeach()
endforeach()

# 2. The click on the probe button, and the backend swap, exist only in the smoke.
set(smoke_sends 0)
set(backend_assigns 0)
foreach(file "${window_side}" "${smoke}" "${ui_file}" "${main_file}")
    file(STRINGS "${file}" lines)
    get_filename_component(name "${file}" NAME)
    foreach(line IN LISTS lines)
        if(line MATCHES "(SendMessage|PostMessage|SendNotifyMessage|SendMessageTimeout)[AW]?[(]" AND line MATCHES "kLiveProbeButtonId")
            if(NOT name STREQUAL "wpd_dual_preview_live_probe_smoke.hpp")
                message(FATAL_ERROR "live capture probe source check: a message to the probe button outside the smoke: ${name}: ${line}")
            endif()
            math(EXPR smoke_sends "${smoke_sends} + 1")
        endif()
        if(line MATCHES "(^|[^A-Za-z_])live_probe_backend[ \t]*=[^=]")
            if(name STREQUAL "wpd_dual_preview_live_probe_smoke.hpp")
                math(EXPR backend_assigns "${backend_assigns} + 1")
            elseif(NOT name STREQUAL "wpd_dual_preview_live_probe_ui.hpp")
                message(FATAL_ERROR "live capture probe source check: live_probe_backend assigned outside the smoke: ${name}: ${line}")
            elseif(NOT line MATCHES "RunLiveProbeOnCamera")
                message(FATAL_ERROR "live capture probe source check: the window side assigns a backend other than the real one: ${line}")
            endif()
        endif()
    endforeach()
endforeach()
if(smoke_sends EQUAL 0)
    message(FATAL_ERROR "live capture probe source check: the smoke's click on the probe button was not found")
endif()
if(backend_assigns EQUAL 0)
    message(FATAL_ERROR "live capture probe source check: the smoke's backend assignment was not found")
endif()

# 3. The probe header refuses to compile outside the probe build; the glue is included only under the macro.
file(READ "${probe_header}" header_text)
if(NOT header_text MATCHES "#if !defined[(]A0_ENABLE_WPD_LIVE_CAPTURE_PROBE[)][\r\n]+#error")
    message(FATAL_ERROR "live capture probe source check: the probe header does not refuse to compile without the build option")
endif()
file(READ "${main_file}" main_text)
file(READ "${ui_file}" ui_text)
foreach(name wpd_dual_preview_live_probe.hpp wpd_dual_preview_live_probe_ui.hpp wpd_dual_preview_live_probe_smoke.hpp)
    set(found 0)
    foreach(text IN ITEMS "${main_text}" "${ui_text}")
        if(text MATCHES "#if defined[(]A0_ENABLE_WPD_LIVE_CAPTURE_PROBE[)][\r\n]+#include \"${name}\"")
            set(found 1)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "live capture probe source check: ${name} is not included under A0_ENABLE_WPD_LIVE_CAPTURE_PROBE")
    endif()
endforeach()
message(STATUS "live capture probe source check: shutter builds=${builds} calls=${calls} smoke_clicks=${smoke_sends} backend_assigns=${backend_assigns}")
